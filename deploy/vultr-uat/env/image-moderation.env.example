# Photo screening service (services/image-moderation; IMAGE-MODERATION-UAT.md). Reached only by the API on the internal
# screening network. API_KEY is generated on this host and shared with the API through env/screening.env.
API_KEY=__GENERATE_PASSWORD:screening-service-key__
# Project Arachnid Shield (known-content / CSAM hash matching). From the GitHub Environment secrets
# UAT_ARACHNID_USERNAME and UAT_ARACHNID_PASSWORD. Without them every photo stays Pending (known-content unchecked).
ARACHNID_API_USERNAME=__OWNER:arachnid-username__
ARACHNID_API_PASSWORD=__OWNER:arachnid-password__
