@inherits LayoutComponentBase
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation
<div class="@(SignedIn ? "member-layout" : "public-layout")">
<header class="app-header">
    <a class="wordmark" href="/" aria-label="Swoovr home">swoovr</a>
    @* Bottom tab bar on phones, top navigation on wider screens (UI-STYLE.md Layout). Connections lists requests and connections (D112); Chats is real messaging (D143). *@
    @* Issue 254 (D342): onboarding has no tabs; nothing else opens until setup is finished. *@
    @if (SignedIn && Path != "/welcome")
    {
    <nav class="tab-bar" aria-label="Main">
        @Tab("Explore", "search", "/explore", Path.StartsWith("/explore") || Path.StartsWith("/travel") || Path.StartsWith("/people/") || Path.StartsWith("/prototype/people"))
        @Tab("Connections", "users", "/connections", Path.StartsWith("/connections"), RequestsBadge)
        @Tab("Chats", "chat", "/chats", Path.StartsWith("/chats") || Path.StartsWith("/prototype/conversation"), ChatsBadge)
        @* Issue 472: the Me tab carries the unread notification count. *@
        @* D442 (issue 585): Me opens the member's own profile; Account settings stays in the settings menu. *@
        @Tab("Me", "user", "/me/profile", MeActive, MeBadge)
    </nav>
    @* issue 217: Me / settings pages put their menu button here (SettingsShell). *@
    <Microsoft.AspNetCore.Components.Sections.SectionOutlet SectionName="@SettingsShell.HeaderActions" />
    }
    else
    {
    <ModeToggle />
    }
</header>
<main id="main-content" tabindex="-1">@Body</main>
<footer class="app-footer"><nav aria-label="Information"><a href="/terms">Terms</a> <a href="/community-guidelines">Community Guidelines</a> <a href="/privacy">Privacy Notice</a> <a href="/safety/advice">Safety Advice</a> @if (SignedIn) { <a href="/settings/appearance">Appearance</a> } <a href="https://swoovr.com/support">Support</a></nav><small class="app-version" data-app-version="@AppVersion.Current.ProductVersion">@AppVersion.Current.DisplayVersion</small></footer>
@* Issue 184 (D318): the floating control and dialog; analytics only where configured for this host. *@
@((MarkupString)PrivacyChoicesMarkup.Html(PrivacyChoicesMarkup.MeasurementId(Configuration, HttpContext?.Request.Host.Host)))
</div>
@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private bool SignedIn => HttpContext?.User.Identity?.IsAuthenticated == true;
    private bool Prototype => Environment.IsDevelopment() && Configuration.GetValue<bool>("Prototype:Enabled");
    private bool MeActive => Path.StartsWith("/account") || Path.StartsWith("/settings") || Path.StartsWith("/me/");
    private string Path => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];

    private static RenderFragment Tab(string label, string icon, string? href, bool active, RenderFragment? badge = null) => href is null
        ? @<span class="tab is-unbuilt" data-tab="@label"><Icon Name="@icon" /><span>@label</span><span class="visually-hidden"> (not built yet)</span></span>
        : badge is null
            ? @<a class="tab" href="@href" data-tab="@label" aria-current="@(active ? "page" : null)"><Icon Name="@icon" /><span>@label</span></a>
            : @<a class="tab" href="@href" data-tab="@label" aria-current="@(active ? "page" : null)"><span class="tab-icon"><Icon Name="@icon" />@badge</span><span>@label</span></a>;

    // Issue 472: the unread count on the Me tab (a WebAssembly island; the layout itself stays static).
    private static readonly RenderFragment MeBadge = @<Swoovr.Web.Client.Notifications.UnreadBadge Where="tab" @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />;
    // Issue 541: unread chat messages on the Chats tab, from the same shared poll.
    private static readonly RenderFragment ChatsBadge = @<Swoovr.Web.Client.Notifications.UnreadBadge Where="chats" Chats="true" @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />;
    // Issue 540: requests waiting for an answer on the Connections tab, from the same shared poll.
    private static readonly RenderFragment RequestsBadge = @<Swoovr.Web.Client.Notifications.UnreadBadge Where="connections" Requests="true" @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />;
}
