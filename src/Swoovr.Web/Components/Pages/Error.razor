@page "/Error"
@using System.Diagnostics

<PageTitle>Something went wrong — Swoovr</PageTitle>

@* Issue 351: signed-out visitors can reach this page (UseAccountEntry), so a failed sign-in is visible instead of
   bouncing to the home page. D321: no development/test notices in the application. *@
<div class="column status-page" data-error-page>
<h1>Something went wrong.</h1>
<p>We couldn't finish that request. Try again, or go back to the home page.</p>

@if (ShowRequestId)
{
    <p class="field-help">
        Reference: <code>@RequestId</code>
    </p>
}

<p class="status-actions"><a class="button button-secondary button-small" href="/">Back to home</a></p>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
