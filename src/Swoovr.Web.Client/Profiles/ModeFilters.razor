@* Issue 442: one mode's discovery filters (D137–D140, D151, D347), shared by "Who I'd like to meet" and the Explore
   filters dialog. Moved unchanged from MatchingPanel: free filters for everyone, Plus distances and sorting when the
   entitlement service says Plus, "not for me" working both ways. Nothing is saved until Save filters (Save in the
   dialog layout, issue 466). *@
@inject MemberClient Members
@if (filter is not null && Layout == "dialog")
{
    @* Issue 466 (owner-approved demo, 24 November 2026): the Explore dialog layout. Compact age selects beside ID Verified
       only, slim Any/All on the Must have heading row, regular-weight chips, Distance and Travel at the bottom and a sticky
       footer (All filters and your details, Reset, Save). Same fields, rules and data attributes as the page layout. *@
    <form @onsubmit="SaveFiltersAsync" data-filter-form="@modeId" data-filter-layout="dialog" class="mf">
        <fieldset disabled="@busy" class="mf-fields">
        <div class="mf-body">
            <section class="mf-sec mf-basics">
                <div class="mf-age" role="group" aria-labelledby="age-label">
                    <span class="mf-age-label" id="age-label">Age</span>
                    <span class="mf-sel mf-sel-age"><label for="min-age" class="visually-hidden">Age from</label>
                        <select id="min-age" @bind="minAge"><option value="">Any</option>@foreach (var n in Ages) { <option value="@n" disabled="@(maxAge is { } top && n > top)">@n</option> }</select></span>
                    <span class="mf-to">to</span>
                    <span class="mf-sel mf-sel-age"><label for="max-age" class="visually-hidden">Age to</label>
                        <select id="max-age" @bind="maxAge"><option value="">Any</option>@foreach (var n in Ages) { <option value="@n" disabled="@(minAge is { } bottom && n < bottom)">@n</option> }</select></span>
                </div>
                <label class="mf-switch"><input type="checkbox" class="mf-toggle" @bind="idVerifiedOnly" data-id-only /><span>ID Verified only</span></label>
            </section>
            <section class="mf-sec" aria-labelledby="want-heading">
                <div class="mf-sec-head">
                    <h3 class="mf-sec-title" id="want-heading">Must have <span class="mf-count">· @required.Count of 5</span></h3>
                    <div class="mf-seg" role="radiogroup" aria-label="Match">
                        <label class="mf-seg-option"><input type="radio" name="match" checked="@(match == "any")" @onchange='() => match = "any"' />Any of these</label>
                        <label class="mf-seg-option"><input type="radio" name="match" checked="@(match == "all")" @onchange='() => match = "all"' />All of these</label>
                    </div>
                </div>
                <div class="mf-chips" role="group" aria-labelledby="want-heading">
                    @foreach (var chip in Chips) { <label class="mf-chip mf-chip-want" title="@(excluded.Contains(chip.Id) ? "In Not for me" : null)"><input type="checkbox" disabled="@(busy || !required.Contains(chip.Id) && (required.Count >= 5 || excluded.Contains(chip.Id)))" checked="@required.Contains(chip.Id)" @onchange="e => Toggle(required, chip.Id, e)" data-required-chip="@chip.Id" /><Icon Name="check" Size="12" /><span>@chip.Label</span></label> }
                </div>
            </section>
            <section class="mf-sec" aria-labelledby="no-heading">
                <h3 class="mf-sec-title" id="no-heading">Not for me <span class="mf-count">· @excluded.Count of 10</span></h3>
                <p class="mf-hint">Works both ways: people who rule you out won’t see you either.</p>
                <div class="mf-chips" role="group" aria-labelledby="no-heading">
                    @foreach (var chip in Chips) { <label class="mf-chip mf-chip-no" title="@(required.Contains(chip.Id) ? "In Must have" : null)"><input type="checkbox" disabled="@(busy || !excluded.Contains(chip.Id) && (excluded.Count >= 10 || required.Contains(chip.Id)))" checked="@excluded.Contains(chip.Id)" @onchange="e => Toggle(excluded, chip.Id, e)" data-excluded-chip="@chip.Id" /><Icon Name="x" Size="12" /><span>@chip.Label</span></label> }
                </div>
            </section>
            <section class="mf-sec" aria-labelledby="where-heading">
                <h3 class="mf-sec-title" id="where-heading">Distance and Travel</h3>
                <div class="mf-pair">
                    <div class="mf-labelled"><label for="distance">Within (km of my home city)</label>
                        <span class="mf-sel"><select id="distance" @bind="distance" data-distance-filter>
                            <option value="">Any distance</option>
                            @foreach (var km in DistanceChoices) { <option value="@km" data-distance-option="@km">@DistanceLabel(km)</option> }
                        </select></span></div>
                    <div class="mf-labelled"><label for="visitors">Visitors in Travel</label>
                        <span class="mf-sel"><select id="visitors" @bind="visitors"><option value="both">Here now and arriving soon</option><option value="current">Here now</option><option value="upcoming">Arriving soon</option><option value="neither">Don't show visitors</option></select></span></div>
                </div>
                <fieldset class="mf-plus" disabled="@(!filter.PlusAvailable)" data-plus-filters="@(filter.PlusAvailable ? "on" : "off")"><legend class="visually-hidden">Plus</legend>
                    <label class="mf-switch"><input type="checkbox" class="mf-toggle" checked="@(sort == "compatibility")" @onchange='e => sort = e.Value is true ? "compatibility" : "recent"' /><span>Most in common first <span class="mf-tag">Plus</span></span></label>
                </fieldset>
                @if (!filter.PlusAvailable) { <p class="mf-hint" data-distance-help>Distances over @(LocationLimits.FreeMaxKm) km and Most in common first are part of Plus.</p> }
            </section>
        </div>
        <div class="mf-foot">
            @* OPEN (issue 466): whether this opens in a new tab or warns about unsaved changes first. Today it is a plain link. *@
            @if (DetailsHref is { } details) { <a class="mf-details" href="@details" data-filter-details>All filters and your details</a> }
            <div class="mf-actions">
                <p role="status" aria-live="polite" class="mf-status" data-filter-status="@filterStatus">@ShortStatus</p>
                @* DEFAULT (issue 466 demo): Reset goes back to this mode's last saved filters and drops its draft. *@
                <button type="button" class="mf-button mf-button-quiet" @onclick="Reset" disabled="@(busy || saving.Contains(modeId))" data-filter-reset>Reset</button>
                @* Codex (PR 465): one save at a time per mode, even across mode switches, so an older save can't land last. *@
                <button type="submit" class="mf-button" disabled="@(busy || saving.Contains(modeId))" data-filter-save="@(saving.Contains(modeId) ? "pending" : "ready")">@(saving.Contains(modeId) ? "Saving…" : "Save")</button>
            </div>
        </div>
        </fieldset>
    </form>
}
else if (filter is not null)
{
    <form @onsubmit="SaveFiltersAsync" data-filter-form="@modeId">
        <fieldset disabled="@busy" class="settings-fields">
        <div class="rd-row rd-start">
            @* Issue 418 (owner): the age range on one line, picked from a list. *@
            <div class="rd-age rd-age-compact" role="group" aria-labelledby="age-label">
                <span class="rd-age-label" id="age-label">Age</span>
                <div class="field"><label for="min-age" class="visually-hidden">Age from</label>
                    <select id="min-age" @bind="minAge"><option value="">Any</option>@foreach (var n in Ages) { <option value="@n" disabled="@(maxAge is { } top && n > top)">@n</option> }</select><span class="field-chevron" aria-hidden="true"><Icon Name="back" Size="18" /></span></div>
                <span class="field-help">to</span>
                <div class="field"><label for="max-age" class="visually-hidden">Age to</label>
                    <select id="max-age" @bind="maxAge"><option value="">Any</option>@foreach (var n in Ages) { <option value="@n" disabled="@(minAge is { } bottom && n < bottom)">@n</option> }</select><span class="field-chevron" aria-hidden="true"><Icon Name="back" Size="18" /></span></div>
            </div>
            <label class="rd-switch"><input type="checkbox" class="ph-switch" @bind="idVerifiedOnly" data-id-only /><span>ID Verified people only</span></label>
        </div>
        <fieldset class="rd-group">
            <legend>Must have <span class="rd-count">· @required.Count of 5</span></legend>
            <div class="segmented" role="radiogroup" aria-label="Match">
                <label class="segment"><input type="radio" name="match" checked="@(match == "any")" @onchange='() => match = "any"' />Any of these</label>
                <label class="segment"><input type="radio" name="match" checked="@(match == "all")" @onchange='() => match = "all"' />All of these</label>
            </div>
            <div class="rd-chips">
                @foreach (var chip in Chips) { <label class="rd-chip"><input type="checkbox" disabled="@(busy || !required.Contains(chip.Id) && (required.Count >= 5 || excluded.Contains(chip.Id)))" checked="@required.Contains(chip.Id)" @onchange="e => Toggle(required, chip.Id, e)" data-required-chip="@chip.Id" />@chip.Label</label> }
            </div>
        </fieldset>
        <fieldset class="rd-group">
            <legend>Not for me <span class="rd-count">· @excluded.Count of 10 · works both ways</span></legend>
            <div class="rd-chips">
                @foreach (var chip in Chips) { <label class="rd-chip rd-chip-no"><input type="checkbox" disabled="@(busy || !excluded.Contains(chip.Id) && (excluded.Count >= 10 || required.Contains(chip.Id)))" checked="@excluded.Contains(chip.Id)" @onchange="e => Toggle(excluded, chip.Id, e)" data-excluded-chip="@chip.Id" />@chip.Label</label> }
            </div>
        </fieldset>
        <div class="rd-grid">
            <div class="field"><label for="visitors">Visitors in Travel</label>
                <select id="visitors" @bind="visitors"><option value="both">Here now and arriving soon</option><option value="current">Here now</option><option value="upcoming">Arriving soon</option><option value="neither">Don't show visitors</option></select><span class="field-chevron" aria-hidden="true"><Icon Name="back" Size="18" /></span></div>
            <div class="field"><label for="distance">Within (km of my home city)</label>
                <select id="distance" @bind="distance" data-distance-filter>
                    <option value="">Any distance</option>
                    @foreach (var km in DistanceChoices)
                    {
                        <option value="@km" data-distance-option="@km">@DistanceLabel(km)</option>
                    }
                </select><span class="field-chevron" aria-hidden="true"><Icon Name="back" Size="18" /></span></div>
        </div>
        <div class="rd-row rd-foot">
            <fieldset class="rd-group" disabled="@(!filter.PlusAvailable)" data-plus-filters="@(filter.PlusAvailable ? "on" : "off")"><legend class="visually-hidden">Plus</legend>
                <label class="rd-switch"><input type="checkbox" class="ph-switch" checked="@(sort == "compatibility")" @onchange='e => sort = e.Value is true ? "compatibility" : "recent"' /><span>Most in common first <span class="rd-tag">Plus</span></span></label>
            </fieldset>
            <div class="rd-actions">
                <p role="status" aria-live="polite" class="field-help rd-status" data-filter-status="@filterStatus">@filterMessage</p>
                @* Codex (PR 465): one save at a time per mode, even across mode switches, so an older save can't land last. *@
                <button type="submit" class="button" disabled="@(busy || saving.Contains(modeId))" data-filter-save="@(saving.Contains(modeId) ? "pending" : "ready")">@(saving.Contains(modeId) ? "Saving…" : "Save filters")</button>
            </div>
        </div>
        @if (!filter.PlusAvailable) { <p class="field-help" data-distance-help>Distances over @(LocationLimits.FreeMaxKm) km and Most in common first are part of Plus.</p> }
        </fieldset>
    </form>
}
else
{
    <p role="status">@(busy ? "Loading this mode’s filters…" : "We couldn’t load this mode’s filters. Choose another mode and try again. Your drafts remain on this page.")</p>
}
@code {
    [Parameter, EditorRequired] public string ModeId { get; set; } = "dating";
    [Parameter, EditorRequired] public IReadOnlyList<ConnectionModeView> Modes { get; set; } = [];
    /// <summary>Called with the saved filters (issue 442: Explore reloads its results).</summary>
    [Parameter] public EventCallback<FilterView> Saved { get; set; }
    /// <summary>"page" (Who I'd like to meet) or "dialog" (issue 466: the Explore filters dialog).</summary>
    [Parameter] public string Layout { get; set; } = "page";
    /// <summary>Dialog layout only: where "All filters and your details" goes (shown in the footer).</summary>
    [Parameter] public string? DetailsHref { get; set; }
    private bool busy, idVerifiedOnly;
    private string modeId = "", match = "any", visitors = "both", sort = "recent";
    private string? filterStatus, filterMessage;
    private HashSet<Guid> required = [], excluded = [];
    private int? minAge, maxAge, distance;
    private FilterView? filter;
    private static readonly IReadOnlyList<int> Ages = Enumerable.Range(18, 103).ToList(); // 18–120, the API's range
    private IEnumerable<IntentionView> Chips => Modes.FirstOrDefault(m => m.Id == modeId)?.Intentions ?? [];

    // D347: the server lists the distances this member's tier allows. A saved wider distance from a lapsed paid plan
    // stays selectable (unchanged it still saves) and is labelled as applying at the Free maximum until they upgrade.
    private static class LocationLimits { public const int FreeMaxKm = 50; }
    private IReadOnlyList<int> Allowed => filter?.DistanceOptions ?? [5, 10, 25, 50];
    private IEnumerable<int> DistanceChoices => distance is { } saved && !Allowed.Contains(saved) ? Allowed.Append(saved) : Allowed;
    private string DistanceLabel(int km) => Allowed.Contains(km) ? $"{km} km" : $"{km} km (Plus; applies as {Allowed.Max()} km now)";

    private static void Toggle<T>(HashSet<T> set, T value, ChangeEventArgs e) { if (e.Value is true) set.Add(value); else set.Remove(value); }

    // Local drafts survive mode changes; nothing is persisted until Save filters succeeds.
    private sealed record Draft(int? Min, int? Max, Guid[] Required, string Match, Guid[] Excluded,
        bool IdOnly, string Visitors, int? Distance, string Sort);
    private readonly Dictionary<string, Draft> drafts = [];
    private Draft Capture() => new(minAge, maxAge, required.ToArray(), match, excluded.ToArray(), idVerifiedOnly, visitors, distance, sort);
    /// <summary>Same filter values (chip order doesn't matter). Records compare arrays by reference, so this compares them as sets.</summary>
    private static bool Same(Draft a, Draft b) => a.Min == b.Min && a.Max == b.Max && a.Match == b.Match && a.IdOnly == b.IdOnly && a.Visitors == b.Visitors
        && a.Distance == b.Distance && a.Sort == b.Sort && a.Required.ToHashSet().SetEquals(b.Required) && a.Excluded.ToHashSet().SetEquals(b.Excluded);
    private void Restore(Draft d) => (minAge, maxAge, required, match, excluded, idVerifiedOnly, visitors, distance, sort) =
        (d.Min, d.Max, d.Required.ToHashSet(), d.Match, d.Excluded.ToHashSet(), d.IdOnly, d.Visitors, d.Distance, d.Sort);
    private bool Dirty => filter is not null && (minAge != filter.MinAge || maxAge != filter.MaxAge ||
        !required.SetEquals(filter.RequiredChips) || match != filter.RequiredMatch || !excluded.SetEquals(filter.ExcludedChips) ||
        idVerifiedOnly != filter.IdVerifiedOnly || visitors != filter.Visitors || distance != filter.MaxDistanceKm || sort != filter.Sort);
    // A new mode keeps the old one's unsaved changes as a draft (the old ChangeModeAsync behaviour).
    protected override async Task OnParametersSetAsync()
    {
        if (ModeId == modeId) return;
        if (filter is not null) { if (Dirty) drafts[modeId] = Capture(); else drafts.Remove(modeId); }
        busy = true; modeId = ModeId; filter = null;
        var load = ++loading;
        try { await LoadFilterAsync(); }
        finally { if (load == loading) busy = false; }
    }
    private int loading;

    private async Task LoadFilterAsync()
    {
        // Codex (PR 465): the member may switch modes while this loads; only the mode still selected may fill the form.
        var requested = modeId;
        var loaded = (await Members.FiltersAsync(requested)).Value;
        if (requested != modeId) return;
        filter = loaded;
        if (filter is null) return;
        Apply(filter);
        (filterStatus, filterMessage) = (null, null);
        if (drafts.TryGetValue(modeId, out var draft))
        {
            Restore(draft);
            (filterStatus, filterMessage) = ("draft", "Your unsaved changes for this mode are restored. Save filters to keep them.");
        }
    }

    /// <summary>Issue 466: the dialog's footer status is one short line; problems keep their full wording.</summary>
    private string? ShortStatus => filterStatus switch { "saved" => "Saved", "draft" => "Unsaved changes restored", "reset" => "Back to saved", _ => filterMessage };

    /// <summary>DEFAULT (issue 466): back to this mode's last saved filters. Nothing is sent; the draft for this mode is dropped.</summary>
    private void Reset()
    {
        if (filter is null || busy || saving.Contains(modeId)) return;
        Apply(filter); drafts.Remove(modeId);
        (filterStatus, filterMessage) = ("reset", "Back to your saved filters.");
    }

    private void Apply(FilterView view) => (minAge, maxAge, required, match, excluded, idVerifiedOnly, visitors, distance, sort) = (view.MinAge, view.MaxAge,
        view.RequiredChips.ToHashSet(), view.RequiredMatch, view.ExcludedChips.ToHashSet(), view.IdVerifiedOnly, view.Visitors, view.MaxDistanceKm, view.Sort);

    /// <summary>Modes with a save in flight. Tracked apart from loading, so returning to a mode can't start a second save.</summary>
    private readonly HashSet<string> saving = [];

    private async Task SaveFiltersAsync()
    {
        if (busy || !saving.Add(modeId)) return;
        try { await SaveOnceAsync(); }
        finally { saving.Remove(saveMode!); saveMode = null; StateHasChanged(); }
    }
    private string? saveMode;

    private async Task SaveOnceAsync()
    {
        busy = true; saveMode = modeId;
        // Codex (PR 465): the member may switch modes while this saves. The save belongs to the mode it was made in:
        // it clears that mode's draft, and changes this form (values, status, busy) only if that mode is still loaded.
        var savedMode = modeId; var generation = loading; var submitted = Capture();
        var result = await Members.SaveFiltersAsync(savedMode, new FilterUpdate(minAge, maxAge, required.ToList(), match, excluded.ToList(), idVerifiedOnly, visitors, distance, sort));
        // Codex (PR 465): clear the draft only if it still holds what was submitted; edits made since stay.
        if (result.Ok && drafts.TryGetValue(savedMode, out var pending) && Same(pending, submitted)) drafts.Remove(savedMode);
        if (savedMode != modeId) return;
        if (generation != loading)
        {
            // Back on this mode after a reload: show what was saved, unless the member has changed something since.
            if (result.Ok && result.Value is { } later && filter is not null && (!Dirty || Same(Capture(), submitted))) { filter = later; Apply(later); (filterStatus, filterMessage) = ("saved", "Filters saved."); }
            return;
        }
        busy = false;
        if (result.Ok && result.Value is { } saved) { filter = saved; await Saved.InvokeAsync(saved); }
        (filterStatus, filterMessage) = result.Ok ? ("saved", "Filters saved.") : (result.Code ?? "failed", result.Code == ProblemCodes.PlusRequired
            ? "That filter is part of Plus." : "Check the filters: ages 18–120, up to 5 must-haves and 10 not-for-me, never the same intention in both.");
    }}
