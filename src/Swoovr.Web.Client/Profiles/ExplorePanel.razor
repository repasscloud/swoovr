@implements IDisposable
@* Explore (D92, Interactive WebAssembly): the four-mode segmented control, then the people the API returns for the
   selected mode. Labels and order come from the API's mode records; the API decides who appears (both have the mode
   on, the person made it visible, adult, on the beta, both living in the same open market, D125) and which badges each
   tile shows (Q11). Without a home city, or outside every open market, the API refuses and the page says why. Travel is
   not a mode and has its own screen. *@
@inject MemberClient Members
@inject NavigationManager Navigation
@inject IJSRuntime JS
@* Issue 442 (owner-approved demo, 24 November 2026): the mode switcher on the heading row, one market line, filters in a
   dialog without leaving Explore, a dismissible first-visit notice and a Travel button. Who appears is unchanged. *@
<div class="page-heading explore-heading" data-explore="@(loaded ? "ready" : "loading")">
    <div class="explore-title-row">
        <h1>Explore</h1>
        @if (loaded && refused is null)
        {
            <nav class="segmented explore-modes" aria-label="Connection mode" data-modes="@string.Join(" ", modes.Select(m => m.Id))">
                @foreach (var mode in modes)
                {
                    <button type="button" class="segment" aria-pressed="@(mode.Id == selected ? "true" : "false")" aria-current="@(mode.Id == selected ? "page" : null)"
                            data-mode="@mode.Id" @onclick="() => SelectAsync(mode.Id)">@mode.Label</button>
                }
            </nav>
        }
    </div>
    @if (!loaded) { <p role="status">Loading…</p> }
    else if (refused is not null) { <p role="status" data-explore-refused="@refused">@RefusedText</p> }
    else
    {
        <div class="explore-toolbar">
            @* Owner (issue 442): the market only; the selected mode is already shown by the switcher. *@
            <p class="explore-market">
                @if (market is not null) { <span data-explore-market data-explore-visiting="@(visitingCity is null ? "false" : "true")">@(visitingCity is { } city ? $"Visiting {city}: people in {market}" : $"People in {market}")</span> }
                <button type="button" class="link-button" @onclick="ShowNoticeAsync" data-explore-about>ⓘ About Explore</button>
            </p>
            <div class="explore-actions">
                <button type="button" class="button button-secondary explore-action" @ref="filtersButton" @onclick="() => filtersOpen = true" disabled="@(selected.Length == 0)" data-discovery-filters>Review filters</button>
                <a class="button explore-action" href="/travel" data-travel-link>✈️ Travel</a>
            </div>
        </div>
        @if (noticeOpen)
        {
            <section class="explore-notice" aria-label="About Explore" data-discovery-guidance>
                <p>@DiscoveryText.Context</p>
                <button type="button" class="explore-notice-close" aria-label="Dismiss" @onclick="DismissNoticeAsync" data-explore-notice-close><Icon Name="x" Size="18" /></button>
            </section>
        }
    }
</div>
@if (loaded && refused is null)
{
    <section class="explore-results" aria-live="polite" data-explore-mode="@selected" data-explore-state="@state">
        @if (state == "off")
        {
            <div class="card notice" data-explore-local="mode-not-enabled">
                <p>@Label(selected) is off for you, so you can't see who's here.</p>
                <a class="button notice-action" href="/me/profile">Turn on @Label(selected)</a>
            </div>
        }
        else if (state == ProblemCodes.DateOfBirthRequired)
        {
            <div class="card notice" data-explore-local="date-of-birth-required">
                <p>Explore needs your date of birth. It's never shown to anyone.</p>
                <a class="button notice-action" href="/account">Add date of birth</a>
            </div>
        }
        else if (state == ProblemCodes.DatingDetailsRequired)
        {
            <div class="card notice" data-explore-local="dating-details-required">
                <p>Dating needs your gender and who you'd like to see.</p>
                <a class="button notice-action" href="/me/matching">Set up Dating</a>
            </div>
        }
        else if (state == ProblemCodes.HomeCityRequired)
        {
            <div class="card notice" data-explore-local="home-city-required">
                <p>Explore shows people in your community, so it needs your home city. Only you can see it.</p>
                <a class="button notice-action" href="/me/profile">Set your home city</a>
            </div>
        }
        else if (state == ProblemCodes.MarketNotOpen)
        {
            <div class="card notice" data-explore-local="market-not-open" data-interest="@(interested ? "on" : "off")">
                <p>Swoovr isn't available in your area yet. We're expanding to new cities.</p>
                @if (interested)
                {
                    <p>We'll let you know when Swoovr opens near you.</p>
                    <button type="button" class="button button-secondary" disabled="@busy" @onclick="() => InterestAsync(false)">Stop telling me</button>
                }
                else
                {
                    <button type="button" class="button" disabled="@busy" @onclick="() => InterestAsync(true)">Tell me when it opens</button>
                }
                <p class="field-help">You can still plan <a class="link" href="/travel">trips</a> to a Swoovr city.</p>
            </div>
        }
        else if (state == "loading") { <p role="status">Loading…</p> }
        else if (state == "unavailable")
        {
            <p role="status" data-explore-unavailable>We couldn't load these profiles. Try again later.</p>
        }
        else
        {
            @if (people.Count == 0)
            {
                <section class="card notice" data-explore-empty-state>
                    <p data-explore-empty>@DiscoveryText.Empty</p>
                    <p class="field-help">@DiscoveryText.Choices</p>
                </section>
            }
            @if (people.Count > 0)
            {
            <div class="people-grid explore-grid">
                @foreach (var person in people)
                {
                    @* D348: a band only when both members show their distance; never a distance. *@
                    @* Issue 443 (D398): one card shape for photo and quote cards; issue 476 fills its overlay and detail slots. *@
                    <MemberCard Name="@person.DisplayName" Age="@person.Age" Identity="@MemberText.CardIdentity(person)" Online="@(person.Online && !onlineExpired)" Href="@($"/people/{person.Id}?mode={selected}")" Detail="@(person.Visiting is { } where && person.Photo is null ? $"Visiting {where}" : MemberText.Distance(person.Distance) ?? "")"
                                Intentions="person.Intentions" Quote="@(person.PictureText ?? Quote(person.About))" Photo="@(person.Photo is { } photo ? TilePhoto(photo, person.DisplayName) : null)" Overlays="@Overlays(person)" Status="@MemberText.CardStatus(person)">
                        <Badges><CardBadges Badges="person.Badges" /></Badges>
                    </MemberCard>
                }
            </div>
            }
        }
    </section>
    <MemberDialog Kind="filters" Title="@($"{Label(selected)} filters")" Open="filtersOpen" Closed="() => filtersOpen = false" ReturnFocus="filtersButton">
        @* Issue 466: the dialog layout; "Changes apply to … when you save" is gone and the details link is in the footer. *@
        <ModeFilters ModeId="@selected" Modes="modes" Saved="FiltersSavedAsync" Layout="dialog" DetailsHref="/me/matching" />
    </MemberDialog>
}
@code {
    private bool loaded, filtersOpen, noticeOpen;
    private ElementReference filtersButton;
    /// <summary>Issue 442 DEFAULT (owner-confirmed): the notice is dismissed per browser, never synced; ⓘ brings it back.</summary>
    private const string NoticeKey = "swoovr.explore.notice-dismissed";
    private string? refused;
    private string? market, visitingCity;
    private bool interested, busy;
    private string selected = "";
    private string state = "loading";
    private long requestRevision;
    private bool disposed;
    public void Dispose(){disposed=true;requestRevision++;}
    private List<ConnectionModeView> modes = [];
    private MyProfileView? mine;
    private IReadOnlyList<ProfileCard> people = [];
    // PR 526 review: the dots from one load go after MemberText.OnlineShownFor.
    private bool onlineExpired;

    private string RefusedText => refused switch
    {
        ProblemCodes.BetaNotEnrolled => "Explore opens once your email is on the invitation list.",
        ProblemCodes.AccountLocked => "This account is locked.",
        _ => "We couldn't load Explore. Try again later.",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var catalogue = await Members.ModesAsync();
            var profile = await Members.ProfileAsync();
            if (catalogue.Value is null || profile.Value is null) refused = catalogue.Code ?? profile.Code ?? "unavailable";
            else
            {
                (modes, mine, interested) = (catalogue.Value, profile.Value, profile.Value.MarketInterest);
                // Start on ?mode= when it names a shown mode (issue 389: onboarding ends on the first enabled mode), else
                // the first mode the member has on, else the first one shown.
                var asked = RequestedMode();
                selected = modes.Any(m => m.Id == asked) ? asked! : mine.Modes.FirstOrDefault(m => m.Enabled)?.Id ?? modes.FirstOrDefault()?.Id ?? "";
            }
        }
        catch (HttpRequestException) { refused = "unavailable"; }
        loaded = true;
        if (refused is null)
        {
            try { noticeOpen = await JS.InvokeAsync<string?>("localStorage.getItem", NoticeKey) is null; }
            catch (Exception error) when (error is JSException or InvalidOperationException) { noticeOpen = true; }
        }
        if (refused is null && selected.Length > 0) await SelectAsync(selected);
    }

    private async Task SelectAsync(string modeId)
    {
        if(disposed)return;
        var revision=++requestRevision;
        (selected, state, people,market,onlineExpired) = (modeId, "loading", [],null,false);
        ApiResult<ExploreResult> result;
        try{result=await Members.ExploreAsync(modeId);}
        catch(Exception error)when(error is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or InvalidOperationException or NotSupportedException)
        {
            if(!disposed&&revision==requestRevision)(state,people,market)=("unavailable",[],null);
            return;
        }
        if(disposed||revision!=requestRevision||selected!=modeId)return;
        (state, people, market) = result.Code switch
        {
            ProblemCodes.ModeNotEnabled => ("off", [], market),
            ProblemCodes.HomeCityRequired or ProblemCodes.MarketNotOpen or ProblemCodes.DateOfBirthRequired or ProblemCodes.DatingDetailsRequired => (result.Code, [], null),
            _ when result.Ok && result.Value is {People:not null} found => ("ready", (IReadOnlyList<ProfileCard>)found.People, found.Market),
            _ => ("unavailable", [], null),
        };
        // D352: while a checked-in trip is active, Explore is that destination's market.
        visitingCity = result.Ok ? result.Value?.Visiting : null;
        if (people.Any(p => p.Online)) _ = ExpireOnlineAsync(revision);
    }

    private async Task ExpireOnlineAsync(long revision)
    {
        try { await Task.Delay(MemberText.OnlineShownFor); }
        catch (TaskCanceledException) { return; }
        if (disposed || revision != requestRevision) return;
        onlineExpired = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DismissNoticeAsync()
    {
        noticeOpen = false;
        try { await JS.InvokeVoidAsync("localStorage.setItem", NoticeKey, "1"); }
        catch (Exception error) when (error is JSException or InvalidOperationException) { }
    }

    private async Task ShowNoticeAsync()
    {
        noticeOpen = true;
        try { await JS.InvokeVoidAsync("localStorage.removeItem", NoticeKey); }
        catch (Exception error) when (error is JSException or InvalidOperationException) { }
    }

    // Saved filters change who's shown: reload this mode's results behind the dialog.
    private Task FiltersSavedAsync(FilterView _) => SelectAsync(selected);

    private async Task InterestAsync(bool on)
    {
        busy = true;
        if (await Members.MarketInterestAsync(on) == 204) interested = on;
        busy = false;
    }

    private string? RequestedMode()
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        return query.Split('&', StringSplitOptions.RemoveEmptyEntries).Select(p => p.Split('=', 2))
            .Where(p => p.Length == 2 && p[0] == "mode").Select(p => Uri.UnescapeDataString(p[1])).FirstOrDefault();
    }

    private string Label(string id) => modes.FirstOrDefault(m => m.Id == id)?.Label ?? id;

    // Photo-free tiles show a short quote (UI-STYLE.md); photos are not part of profiles yet.
    // Issue 443: no words and no about → no quote (the card shows the initial); never a made-up line.
    private static string? Quote(string? about) => string.IsNullOrWhiteSpace(about) ? null : about.Length <= 90 ? about : about[..89].TrimEnd() + "…";

    // D203: an approved photo through its short-lived link. Issue 467 (owner): right-click and drag are blocked, which
    // only stops casual saving.
    /// <summary>Issue 496 (D407): over a photo only. Explore lists nobody with an upcoming trip, so travel here is always a check-in.</summary>
    private static RenderFragment? Overlays(ProfileCard person) => person.Photo is null || person.Visiting is null && person.PhotoCount < 2 ? null
        : @<text>@if (person.Visiting is { } where) { <span class="mc-pill mc-pill-travel" data-tile-visiting><Icon Name="pin" Size="12" /><span>Visiting @where</span></span> }
            @if (person.PhotoCount > 1) { <span class="mc-pill mc-pill-count" data-tile-photos="@person.PhotoCount"><Icon Name="image" Size="12" /><span class="visually-hidden">@person.PhotoCount photos</span><span aria-hidden="true">@person.PhotoCount</span></span> }</text>;

    private static RenderFragment TilePhoto(PhotoView photo, string name) => builder =>
    {
        builder.OpenElement(0, "img");
        builder.AddAttribute(1, "src", PhotoText.Web(photo.Link));
        builder.AddAttribute(2, "alt", $"{name}'s photo");
        builder.AddAttribute(3, "loading", "lazy");
        builder.AddAttribute(4, "data-tile-photo", photo.Id.ToString());
        builder.AddAttribute(5, "draggable", "false");
        builder.AddAttribute(6, "data-photo-guard", true);
        builder.AddEventPreventDefaultAttribute(7, "oncontextmenu", true);
        builder.AddEventPreventDefaultAttribute(8, "ondragstart", true);
        builder.CloseElement();
    };
}
