@* Another member's profile (D92, Interactive WebAssembly). The API returns it only in modes both people have on and
   the person shows themselves in; anything else reads as "not available", so the page never confirms who exists.
   Badges are the public ones the API returns, several at once in the configured order (Q11). *@
@inject MemberClient Members
@inject NavigationManager Navigation
<div class="page-heading" data-person="@(loaded ? (blockedNow ? "blocked" : person is null ? "unavailable" : "ready") : "loading")">
    <p class="breadcrumb"><a href="/explore">Explore</a> / Profile</p>
    @if (!loaded) { <p role="status">Loading…</p> }
    else if (blockedNow) { <h1>Blocked</h1> }
    else if (person is null)
    {
        <h1>Profile not available</h1>
        <p role="status">This profile isn't showing in any mode you use.</p>
    }
    else
    {
        <div class="person-name person-head"><h1>@person.DisplayName</h1><ProfileBadges Badges="person.Badges" Name="@person.DisplayName" Opening="() => safetyOpen = false" /></div>
        @* Issue 447: the key facts the person chose to show (D175), on one line. Nothing is invented or derived from ID data. *@
        @if (KeyFacts is { Count: > 0 } facts)
        {
            <p class="person-facts" data-person-facts>@string.Join(" · ", facts)
                @if (MemberText.Distance(person.Distance) is { } distance) { <span class="person-facts-distance" data-person-distance><Icon Name="pin" Size="13" />@distance</span> }</p>
        }
        else if (MemberText.Distance(person.Distance) is { } distance) { <p class="person-facts" data-person-distance><Icon Name="pin" Size="13" />@distance</p> }
        @* Issue 446: one primary action and a compact safety menu; each action opens a dialog with the existing flow. *@
        <div class="person-action-bar" data-person-actions>
            @if (person.Modes.Any(m => m.Connection == "connected"))
            {
                @* D143: one conversation per connected pair, across modes. *@
                <button type="button" class="button person-action" disabled="@busy" @onclick="MessageAsync" data-message-person>Message @person.DisplayName</button>
                <button type="button" class="button button-secondary person-action" @ref="connectButton" @onclick="() => dialog = Dialogs.Connect" data-open-connect>@ConnectLabel</button>
            }
            else
            {
                <button type="button" class="button person-action" @ref="connectButton" @onclick="() => dialog = Dialogs.Connect" data-open-connect>@ConnectLabel</button>
            }
            <div class="safety-menu">
                <button type="button" class="button button-secondary person-action" @ref="safetyButton" aria-expanded="@(safetyOpen ? "true" : "false")" aria-controls="person-safety-menu"
                        @onclick="() => safetyOpen = !safetyOpen" data-safety-menu><Icon Name="shield" Size="16" /> Report or block</button>
                @if (safetyOpen)
                {
                    <ul id="person-safety-menu" class="safety-menu-list" data-safety-menu-list>
                        <li><button type="button" class="safety-menu-item" @onclick="() => Open(Dialogs.Report)" data-report-open>Report @person.DisplayName</button></li>
                        <li><button type="button" class="safety-menu-item" @onclick="() => Open(Dialogs.Block)" data-block-open>Block @person.DisplayName</button></li>
                        @* D190: the separate Serious Safety Incident pathway, its own page. *@
                        <li><a class="safety-menu-item" href="@($"/me/safety/report?type=profile&id={Id}")" data-serious-link>Report a serious safety incident</a></li>
                    </ul>
                }
            </div>
        </div>
        <p role="status" aria-live="polite" class="field-help person-message-status" data-message-status="@messageStatus">@messageError</p>
        @if (ConnectSummary is { Length: > 0 } summary) { <p class="field-help person-connect-summary" data-connect-summary>@summary</p> }
    }
</div>
@if (person is not null)
{
    @* Issue 447: one column on a phone; gallery beside the details from tablet width up. No horizontal scrolling. *@
    <div class="person-layout-447" data-person-layout>
    <div class="person-gallery-col">
    @* D203: the main photo, then each shown mode's own photos (approved only, short-lived links; never another mode's).
       Issue 445: each distinct photo once; the main photo is also in its mode's list. *@
    @* Issue 467: each photo is a button that opens it large (PersonPhotoViewer). Right-click and drag are blocked on the
       images (owner): it only stops casual saving; the short-lived links (D203) stay the real protection. *@
    @if (Gallery is { Count: > 0 } gallery)
    {
        <section class="person-gallery" aria-label="Photos" data-person-photos="@gallery.Count">
            @for (var i = 0; i < gallery.Count; i++)
            {
                var at = i; var shown = gallery[at];
                <button type="button" class="person-photo-open@(at == 0 ? " is-lead" : "")" @ref="photoButtons[at]" @onclick="() => OpenPhoto(at)"
                        aria-label="@($"Open {person.DisplayName}'s photo, {at + 1} of {gallery.Count}")" data-person-photo-open="@at">
                    @if (shown.ModeId is null) { <img src="@PhotoText.Web(shown.Photo.Link)" alt="@($"{person.DisplayName}'s photo")" class="person-photo person-photo-lead" draggable="false" @oncontextmenu:preventDefault="true" @ondragstart:preventDefault="true" data-photo-guard data-person-photo="main" /> }
                    else { <img src="@PhotoText.Web(shown.Photo.Link)" alt="@($"{person.DisplayName}'s photo in {shown.ModeLabel}")" class="person-photo@(at == 0 ? " person-photo-lead" : "")" draggable="false" @oncontextmenu:preventDefault="true" @ondragstart:preventDefault="true" data-photo-guard data-person-photo="@shown.ModeId" loading="lazy" /> }
                </button>
            }
        </section>
        @if (viewerAt is { } open)
        {
            <PersonPhotoViewer Photos="gallery" Index="open" IndexChanged="i => viewerAt = i" Name="@person.DisplayName" OnClose="ClosePhoto" OnReport="ReportPhoto" />
        }
    }
    else if (person.PictureText is { } words)
    {
        @* Issue 389 (D382): the member's own words as a text picture while no approved photo shows. *@
        <section class="person-gallery" aria-label="Text picture" data-person-picture-text>
            <figure class="profile-quote person-text-picture"><span class="tile-quote-mark" aria-hidden="true" data-font="quote">&ldquo;</span><p class="tile-quote" data-font="quote">@words</p></figure>
        </section>
    }
    </div>
    <div class="person-details-col" data-shared-modes="@string.Join(" ", person.Modes.Select(m => m.Id))">
    @* D175: each mode shows its own about (the core about where none is set); one block when they're all the same. *@
    @if (person.Modes.Select(m => m.About).Distinct().Count() > 1)
    {
        <section class="card person-card" aria-labelledby="about-heading" data-about="per-mode">
            <h2 id="about-heading">About me</h2>
            @foreach (var mode in person.Modes.Where(m => m.About is not null))
            {
                <h3 class="person-subhead">In @mode.Label</h3>
                <p class="person-about" data-about-mode="@mode.Id">@mode.About</p>
            }
        </section>
    }
    else if (person.About is not null)
    {
        <section class="card person-card" aria-labelledby="about-heading">
            <h2 id="about-heading">About me</h2>
            <p class="person-about" data-about="@person.Modes[0].Id">@person.About</p>
        </section>
    }
    @* Issue 447: what they're here for in each shown mode, once. The mode's own name only when it differs (D301), and
       Dating's orientation only when they chose to show it (D175). *@
    @if (person.Modes.Any(HasDetails))
    {
    <section class="card person-card" aria-labelledby="shared-heading" data-person-details>
        <h2 id="shared-heading">@(person.Modes.Count == 1 ? $"In {person.Modes[0].Label}" : "Here for")</h2>
        @foreach (var mode in person.Modes.Where(HasDetails))
        {
            <div class="person-mode" data-person-mode="@mode.Id">
                @if (person.Modes.Count > 1) { <h3 class="person-subhead">@mode.Label</h3> }
                @if (mode.DisplayName is { } named && named != person.DisplayName) { <p class="person-mode-name" data-mode-public-name="@mode.Id">Goes by @named here</p> }
                @if (mode.Orientation is { } orientation) { <p class="person-mode-fact" data-person-orientation>@orientation</p> }
                @if (mode.Intentions.Count > 0)
                {
                    <ul class="chip-row" aria-label="@($"Looking for in {mode.Label}")">@foreach (var intention in mode.Intentions) { <li><span class="chip is-on">@intention</span></li> }</ul>
                }
            </div>
        }
    </section>
    }
    </div>
    </div>
    <MemberDialog Kind="connect" Title="@($"Connect with {person.DisplayName}")" Open="@(dialog == Dialogs.Connect)" Closed="Close" ReturnFocus="connectButton" FocusRequest="connectFocus">
        <p class="field-help">A request goes to one mode at a time. Nothing connects until they accept.</p>
        <ul class="request-list" data-connect-modes>
            @foreach (var mode in person.Modes)
            {
                <li data-connect-mode="@mode.Id" data-connection="@mode.Connection">
                    <span class="chip">@mode.Label</span>
                    @switch (mode.Connection)
                    {
                        case "connected":
                            <span class="field-help" data-connection-label>@MemberText.ConnectionLabel(mode.Id)</span>
                            @if (confirmDisconnect == mode.Id)
                            {
                                <span class="field-help">@MemberText.DisconnectExplained</span>
                                <button type="button" class="button" disabled="@busy" @onclick="() => DisconnectAsync(mode.ConnectionId!.Value)" data-disconnect-confirm>Disconnect</button>
                                <button type="button" class="button button-secondary" @onclick="() => confirmDisconnect = null">Keep</button>
                            }
                            else if (mode.ConnectionId is not null)
                            {
                                <button type="button" class="button button-secondary" disabled="@busy" @onclick="() => confirmDisconnect = mode.Id" data-disconnect>Disconnect</button>
                            }
                            break;
                        case "sent":
                            <span class="field-help">Request sent</span>
                            <button type="button" class="button button-secondary" disabled="@busy" @onclick='() => AnswerAsync(mode.RequestId!.Value, "withdraw")'>Withdraw</button>
                            break;
                        case "received":
                            <button type="button" class="button" disabled="@busy" @onclick='() => AnswerAsync(mode.RequestId!.Value, "accept")'>Accept</button>
                            <button type="button" class="button button-secondary" disabled="@busy" @onclick='() => AnswerAsync(mode.RequestId!.Value, "decline")'>Decline</button>
                            break;
                        case "none" when !mode.CanRequest && mode.ArrivalRequired:
                            @* D142, D149: a traveller may look before arriving but not start contact. *@
                            <span class="field-help" data-request-unavailable="arrival">@MemberText.RequestProblem(ProblemCodes.ArrivalRequired)</span>
                            break;
                        case "none" when !mode.CanRequest:
                            @* D125: no remote contact; the API refuses it too. *@
                            <span class="field-help" data-request-unavailable>@MemberText.RequestUnavailable</span>
                            break;
                        default:
                            <button type="button" class="button" disabled="@busy" @onclick="() => SendAsync(mode.Id)">Send request</button>
                            break;
                    }
                </li>
            }
        </ul>
        <p role="status" aria-live="polite" class="field-help" data-connect-status="@connectStatus">@connectMessage</p>
    </MemberDialog>
    <MemberDialog Kind="block" Title="@($"Block {person.DisplayName}?")" Open="@(dialog == Dialogs.Block)" Closed="Close" ReturnFocus="safetyButton">
        <div data-block="confirm">
            <p>You won't see each other anywhere on Swoovr, and any requests between you are cancelled. They aren't told.</p>
            <p class="account-actions">
                <button type="button" class="button" disabled="@busy" @onclick="BlockAsync">Block</button>
                <button type="button" class="button button-secondary" @onclick="Close">Cancel</button>
            </p>
        </div>
    </MemberDialog>
    @* Issue 467 (CONFIRMED): Report photo uses the existing report flow; the report records which photo it was. *@
    <MemberDialog Kind="report-photo" Title="@($"Report {person.DisplayName}'s photo")" Open="@(dialog == Dialogs.ReportPhoto)" Closed="Close" ReturnFocus="PhotoOpener" FocusRequest="reportFocus">
        @if (reportPhoto is { } photoId)
        {
            <ReportForm InDialog="true" SubjectType="photo" SubjectId="@photoId.ToString()" Name="@person.DisplayName"
                        Submitted="() => { reportSent = true; reportFocus++; }" Blocked="() => { person = null; blockedNow = true; dialog = null; }" />
        }
    </MemberDialog>
    <MemberDialog Kind="report" Title="@($"Report {person.DisplayName}")" Open="@(dialog == Dialogs.Report)" Closed="Close" ReturnFocus="safetyButton" FocusRequest="reportFocus">
        <ReportForm InDialog="true" SubjectType="@(person.Badges.Any(b => b.Badge == "bot") ? "bot" : "profile")" SubjectId="@Id.ToString()" Name="@person.DisplayName"
                    Submitted="() => { reportSent = true; reportFocus++; }" Blocked="() => { person = null; blockedNow = true; dialog = null; }" />
    </MemberDialog>
}
@if (blockedNow)
{
    <div class="card notice" data-blocked-done>
        <p>Blocked. You won't see each other. You can unblock from <a class="link" href="/connections">Connections</a>.</p>
    </div>
}
@if(reportSent && person is null){<p role="status">@ReportFollowUpText.Confirmation</p><ReportSupport />}
@code {
    [Parameter, EditorRequired] public Guid Id { get; set; }
    [Parameter] public string? Mode { get; set; }
    private string? confirmDisconnect;
    private bool loaded, busy, blockedNow, reportSent, safetyOpen;
    private enum Dialogs { Connect, Block, Report, ReportPhoto }
    private Dialogs? dialog;
    private int connectFocus, reportFocus;
    private string? messageStatus, messageError;
    private ElementReference connectButton, safetyButton;

    private void Open(Dialogs which) => (dialog, safetyOpen) = (which, false);
    private void Close() => dialog = null;

    /// <summary>D203, issue 445: the main photo, then each shown mode's own approved photos, each once.</summary>
    private IReadOnlyList<PhotoText.GalleryPhoto>? Gallery => person is null ? null : PhotoText.Gallery(person.Photo, person.Modes.Select(m => (m.Id, m.Label, m.Photos)));
    // Issue 467: the open photo, and the gallery button that opened it (focus goes back there).
    private int? viewerAt;
    private int opener;
    private Guid? reportPhoto;
    private bool focusOpener;
    private readonly Dictionary<int, ElementReference> photoButtons = [];
    private ElementReference? PhotoOpener => photoButtons.TryGetValue(opener, out var button) ? button : null;
    private void OpenPhoto(int at) => (viewerAt, opener, safetyOpen) = (at, at, false);
    private void ClosePhoto() => (viewerAt, focusOpener) = (null, true);
    private void ReportPhoto(Guid id) => (viewerAt, reportPhoto, dialog) = (null, id, Dialogs.ReportPhoto);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusOpener) return;
        focusOpener = false;
        if (PhotoOpener is { } button) { try { await button.FocusAsync(); } catch (InvalidOperationException) { } }
    }

    /// <summary>Issue 447: age, gender and pronouns, each only when the API returned it (the person's own switches, D175/D382).</summary>
    private List<string>? KeyFacts => person is null ? null : new[] { person.Age?.ToString(), person.Gender, person.Pronouns }.OfType<string>().Where(f => f.Length > 0).ToList();

    /// <summary>Issue 447: a mode is listed only with something real to show; visitors never see filler.</summary>
    private bool HasDetails(SharedModeView mode) => mode.Intentions.Count > 0 || mode.Orientation is not null || mode.DisplayName is { } n && n != person?.DisplayName;

    /// <summary>The primary button: what the viewer can do next across the shared modes.</summary>
    private string ConnectLabel => person?.Modes switch
    {
        { } modes when modes.Any(m => m.Connection == "received") => "Respond to request",
        { } modes when modes.All(m => m.Connection == "connected") => "Connections",
        _ => "Connect",
    };

    /// <summary>Where the two stand, per mode, so the state shows without opening the dialog.</summary>
    private string? ConnectSummary => person is null ? null : string.Join(" · ", person.Modes.Where(m => m.Connection != "none")
        // Bracketed for the reader (Codex, PR 465): C# already binds the switch before +, but this can't be misread.
        .Select(m => $"{m.Label}: " + (m.Connection switch { "connected" => "connected", "sent" => "request sent", "received" => "wants to connect", _ => m.Connection })));
    private string? connectStatus, connectMessage;
    private PersonProfile? person;

    protected override async Task OnParametersSetAsync()
    {
        try { person = (await Members.PersonAsync(Id, Mode)).Value; }
        catch (HttpRequestException) { person = null; }
        loaded = true;
    }

    private async Task SendAsync(string modeId)
    {
        busy = true;
        var result = await Members.SendRequestAsync(Id, modeId);
        (connectStatus, connectMessage) = result.Ok ? ("sent", "Request sent.") : (result.Code ?? "failed", MemberText.RequestProblem(result.Code));
        await ReloadAsync();
    }

    private async Task AnswerAsync(Guid requestId, string answer)
    {
        busy = true;
        var result = await Members.AnswerRequestAsync(requestId, answer);
        (connectStatus, connectMessage) = result.Ok ? (answer, answer == "accept" ? "Connected." : answer == "decline" ? "Declined." : "Request withdrawn.")
            : ("failed", "That request isn't available any more.");
        await ReloadAsync();
    }

    private async Task DisconnectAsync(Guid connectionId)
    {
        busy = true;
        var result = await Members.DisconnectAsync(connectionId);
        (connectStatus, connectMessage) = result.Ok ? ("disconnected", "Disconnected. They won't be told.") : ("failed", "That connection isn't available any more.");
        confirmDisconnect = null;
        await ReloadAsync();
    }

    private async Task MessageAsync()
    {
        busy = true;
        var selected = person?.Modes.FirstOrDefault(m => m.Id == Mode && m.Connection == "connected") ?? person?.Modes.FirstOrDefault(m => m.Connection == "connected");
        var result = selected is null ? await Members.StartConversationAsync(Id) : await Members.StartConversationInModeAsync(Id, selected.Id);
        busy = false;
        if (result.Value is { } conversation) { (messageStatus, messageError) = (null, null); Navigation.NavigateTo($"/chats/{conversation.Id}"); }
        else
        {
            (messageStatus, messageError) = ("failed", "You can message people you're connected with.");
            await ReloadAsync(); // the connection may have ended since the page loaded; the buttons follow
        }
    }

    private async Task BlockAsync()
    {
        busy = true;
        if (await Members.BlockAsync(Id) == 204) (person, blockedNow, dialog) = (null, true, null);
        busy = false;
    }

    private async Task ReloadAsync()
    {
        person = (await Members.PersonAsync(Id, Mode)).Value;
        busy = false;
        connectFocus++;
    }
}
