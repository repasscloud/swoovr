@* Who the member is and who they'd like to meet (D137–D140, Interactive WebAssembly). Gender, pronouns and orientation
   are each optional and separate; Dating needs a gender and a "show me", which is reciprocal. Orientation never
   decides who anyone sees. Filters are per mode: the free ones for everyone (including distance up to 50 km, D347), the
   wider distances and Plus sorting when the entitlement service says Plus (D151). Excluded intentions work both ways: people holding one can't find or contact you in that mode. *@
@inject MemberClient Members
<div class="rd-page">
<div class="page-heading" data-matching="@(loaded ? (options is null ? "refused" : "ready") : "loading")">
    <p class="breadcrumb"><a href="/account">Me</a> / Who I'd like to meet</p>
    <h1>Who I'd like to meet</h1>
    @if (!loaded) { <p role="status">Loading…</p> }
    else if (options is null) { <p role="status">This page opens once your email is on the invitation list.</p> }
</div>
@if (options is not null)
{
    @* Issue 418 (owner-approved mockup): identity in one row, what shows on your profile and Dating's "show me" as chips. *@
    <section class="rd-card" aria-labelledby="identity-heading">
        <div class="rd-row rd-row-baseline"><h2 id="identity-heading">About you</h2><p class="field-help">Orientation never decides who sees you.</p></div>
        <form @onsubmit="SaveIdentityAsync" data-identity-form>
            <div class="rd-grid rd-grid-3">
                <div class="field"><label for="gender">Gender</label>
                    <select id="gender" @bind="gender"><option value="">Not set</option>@foreach (var g in options.Genders) { <option value="@g.Id">@g.Label</option> }</select><span class="field-chevron" aria-hidden="true"><Icon Name="back" Size="18" /></span></div>
                @* Issue 389 (D382): a pronoun list plus Self-describe (50 characters), with its own switch. *@
                <div class="field"><label for="pronouns">Pronouns</label>
                    <select id="pronouns" @bind="pronounId"><option value="">Not set</option>@foreach (var p in options.Pronouns ?? []) { <option value="@p.Id">@p.Label</option> }</select><span class="field-chevron" aria-hidden="true"><Icon Name="back" Size="18" /></span></div>
                <div class="field"><label for="orientation">Orientation</label>
                    <select id="orientation" @bind="orientation"><option value="">Not set</option>@foreach (var o in options.Orientations) { <option value="@o.Id">@o.Label</option> }</select><span class="field-chevron" aria-hidden="true"><Icon Name="back" Size="18" /></span></div>
                @if (gender == "another") { <div class="field"><label for="gender-description">Describe your gender (optional)</label><input id="gender-description" maxlength="40" @bind="genderDescription" /></div> }
                @if (pronounId == "self") { <div class="field"><label for="pronouns-own">Your pronouns</label><input id="pronouns-own" maxlength="50" @bind="pronouns" data-pronouns-own /></div> }
            </div>
            <fieldset class="rd-group"><legend>On my profile</legend>
                <div class="rd-chips">
                    <label class="rd-chip"><input type="checkbox" @bind="showGender" data-show-gender />Gender</label>
                    <label class="rd-chip"><input type="checkbox" @bind="showPronouns" data-show-pronouns />Pronouns</label>
                    <label class="rd-chip"><input type="checkbox" @bind="showOrientation" data-show-orientation />Orientation</label>
                    <label class="rd-chip"><input type="checkbox" @bind="showAge" data-show-age />Age</label>
                </div>
            </fieldset>
            <fieldset class="rd-group" data-show-me><legend>In Dating, show me</legend>
                @* D161: "Prefer not to say" is a privacy choice, not a gender, so it's never a "show me" option. D382 (Q181.1 A): "Man" and
                   "Woman" include Trans man and Trans woman, so the API's ShowMe list has four choices. *@
                <div class="rd-chips">
                    @foreach (var g in options.ShowMe ?? options.Genders.Where(g => g.Id is not ("unsaid" or "trans-man" or "trans-woman")))
                    {
                        <label class="rd-chip"><input type="checkbox" checked="@showMe.Contains(g.Id)" @onchange="e => Toggle(showMe, g.Id, e)" data-show-me-option="@g.Id" />@g.Label</label>
                    }
                </div>
                <p class="field-help">Works both ways: you see someone in Dating only if each of you is in the other's choice. People who prefer not to say their gender can appear for anyone.</p>
            </fieldset>
            <div class="rd-actions">
                <p role="status" aria-live="polite" class="field-help rd-status" data-identity-status="@identityStatus">@identityMessage</p>
                <button type="submit" class="button" disabled="@busy">Save</button>
            </div>
        </form>
    </section>
    <section class="rd-card" aria-labelledby="filters-heading">
        <div class="rd-row">
            <h2 id="filters-heading">Filters</h2>
            <div class="segmented" role="radiogroup" aria-label="Mode">
                @foreach (var m in modes)
                {
                    <label class="segment"><input type="radio" name="filter-mode" value="@m.Id" checked="@(m.Id == modeId)" @onchange="ChangeMode" data-filter-mode="@m.Id" />@m.Label</label>
                }
            </div>
        </div>
        <ModeFilters ModeId="@modeId" Modes="modes" />
    </section>
}
</div>
@code {
    private bool loaded, busy, showGender = true, showOrientation, showAge = true, showPronouns = true;
    private string? pronounId;
    private ProfileOptionsView? options;
    private List<ConnectionModeView> modes = [];
    private string modeId = "dating";
    private string? gender, genderDescription, pronouns, orientation, identityStatus, identityMessage;
    private HashSet<string> showMe = [];

    protected override async Task OnInitializedAsync()
    {
        options = (await Members.ProfileOptionsAsync()).Value;
        if (options is not null)
        {
            modes = (await Members.ModesAsync()).Value ?? [];
            if ((await Members.IdentityAsync()).Value is { } i)
                (gender, genderDescription, pronouns, orientation, showGender, showOrientation, showAge, showMe, pronounId, showPronouns) =
                    (i.Gender, i.GenderDescription, i.PronounId == "self" ? i.Pronouns : null, i.Orientation, i.ShowGender, i.ShowOrientation, i.ShowAge, i.DatingShowMe.ToHashSet(),
                     i.PronounId, i.ShowPronouns);
        }
        loaded = true;
    }

    private static void Toggle<T>(HashSet<T> set, T value, ChangeEventArgs e) { if (e.Value is true) set.Add(value); else set.Remove(value); }

    // Issue 442: the form is ModeFilters, which keeps each mode's unsaved draft when the mode changes.
    private void ChangeMode(ChangeEventArgs e) { if (e.Value?.ToString() is { } next && modes.Any(m => m.Id == next)) modeId = next; }

    private async Task SaveIdentityAsync()
    {
        busy = true;
        var result = await Members.SaveIdentityAsync(new IdentityUpdate(gender, genderDescription, pronounId == "self" ? pronouns : null, orientation, showGender, showOrientation, showAge, showMe.ToList(), string.IsNullOrEmpty(pronounId) ? null : pronounId, showPronouns));
        busy = false;
        (identityStatus, identityMessage) = result.Ok ? ("saved", "Saved.") : (result.Code ?? "failed", "Check the options you picked.");
    }


}
