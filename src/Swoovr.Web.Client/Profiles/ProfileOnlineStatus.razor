@* Issue 499 (D410): opt-in, mutual online status. Off by default; the card is missing where the host doesn't offer it. *@
@inject MemberClient Members
@if (view is { } v && (v.Available || v.ShowOnline))
{
    <section class="rd-card" aria-labelledby="online-heading" data-online-status="@(v.ShowOnline ? "on" : "off")">
        <h2 id="online-heading">Online status</h2>
        <label class="rd-set"><span>Show when I'm online<span class="field-help">A green dot on your card in Explore while you're using Swoovr. Only people who turn this on too see it, and you see theirs. Nobody sees when you were last here.</span></span>
            <input type="checkbox" class="ph-switch" checked="@v.ShowOnline" disabled="@busy" @onchange="SaveAsync" data-show-online /></label>
        <p role="status" aria-live="polite" class="field-help rd-status" data-online-result>@message</p>
    </section>
}
@code {
    private OnlineStatusView? view;
    private bool busy;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try { view = (await Members.OnlineStatusAsync()).Value; }
        catch (HttpRequestException) { }
    }

    private async Task SaveAsync(ChangeEventArgs e)
    {
        busy = true;
        try
        {
            var result = await Members.SaveOnlineStatusAsync(new OnlineStatusUpdate(e.Value is true));
            (view, message) = result.Value is { } saved ? (saved, "Saved.") : (view, "That change wasn't saved. Try again.");
        }
        catch (HttpRequestException) { message = "That change wasn't saved. Try again."; }
        finally { busy = false; }
    }
}
