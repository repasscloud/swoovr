@* #49: the notification centre and its settings. The centre is worded by the API from ids when read, so a block,
   restriction or deletion removes an item at once. Lock screens and emails stay private by default; this page is the
   signed-in member's own view. Settings stop pushes and emails, never the centre. *@
@inject MemberClient Members
@inject UnreadNotifications Unread
<div class="rd-page">
<div class="page-heading" data-notifications="@(loaded ? "ready" : "loading")">
    <p class="breadcrumb"><a href="/account">Me</a> / @NotificationText.Title</p>
    <h1>@NotificationText.Title</h1>
    @if (!loaded) { <p role="status">Loading…</p> }
    else if (barred) { <p data-notifications-barred>Only account notices and updates to your own reports show while it's restricted.</p> }
</div>
@if (loaded)
{
    @* Issue 415: the centre is one compact list; each item has a kind icon, a muted kind and time line, and a dot while unread. *@
    <section class="rd-card" aria-labelledby="centre-heading">
        <div class="rd-row">
            <h2 id="centre-heading">Recent <span class="rd-count" data-unread="@centre.Unread">· @NotificationText.Unread(centre.Unread)</span></h2>
            @if (centre.Unread > 0) { <button type="button" class="button button-secondary button-xs" @onclick="ReadAllAsync" data-read-all>Mark all as read</button> }
        </div>
        @if (centre.Items.Count == 0) { <p class="field-help" data-notification-list="none">@NotificationText.Empty</p> }
        else
        {
            <ul class="rd-notes" data-notification-list="@centre.Items.Count">
                @foreach (var n in centre.Items)
                {
                    <li data-notification="@n.Id" data-notification-kind="@n.Kind" data-notification-read="@(n.Read ? "yes" : "no")">
                        <a class="rd-note" href="@n.Link" data-read="@(n.Read ? "yes" : "no")" @onclick="() => ReadAsync(n)">
                            <span class="rd-note-ico" aria-hidden="true"><Icon Name="@KindIcon(n.Kind)" Size="18" /></span>
                            <span class="rd-note-text"><span class="rd-note-title">@n.Title</span>
                                <span class="field-help">@NotificationText.KindLabel(n.Kind) · @n.At.ToLocalTime().ToString("d MMM, HH:mm")</span></span>
                            @if (!n.Read) { <span class="rd-dot" role="img" aria-label="Unread"></span> }
                        </a>
                    </li>
                }
            </ul>
        }
    </section>
    @if (settings is not null)
    {
        <p class="field-help" data-notification-privacy>@NotificationText.PrivacyNote</p>
        <form class="rd-page" @onsubmit="SaveAsync" data-notification-settings>
            <div class="rd-grid rd-grid-wide">
                <section class="rd-card rd-compact" aria-labelledby="kinds-heading">
                                        <h2 id="kinds-heading">Tell me about</h2>
                    <div>
                        <label class="rd-set"><span>Messages</span><input type="checkbox" class="ph-switch" @bind="form.Messages" data-setting="messages" /></label>
                        <label class="rd-set"><span>Connection requests</span><input type="checkbox" class="ph-switch" @bind="form.Requests" data-setting="requests" /></label>
                        <label class="rd-set"><span>New connections</span><input type="checkbox" class="ph-switch" @bind="form.Connections" data-setting="connections" /></label>
                        <label class="rd-set"><span>Travel reminders</span><input type="checkbox" class="ph-switch" @bind="form.Travel" data-setting="travel" /></label>
                    </div>
                </section>
                <section class="rd-card rd-compact" aria-labelledby="how-heading">
                                        <h2 id="how-heading">How</h2>
                    <div>
                        <label class="rd-set"><span>Push notifications on my phone</span><input type="checkbox" class="ph-switch" @bind="form.Push" data-setting="push" /></label>
                        <label class="rd-set"><span>Email<span class="field-help">@NotificationText.EmailHelp</span></span><input type="checkbox" class="ph-switch" @bind="form.Email" data-setting="email" /></label>
                        <label class="rd-set"><span>Private previews<span class="field-help">@NotificationText.PreviewsHelp</span></span><input type="checkbox" class="ph-switch" @bind="form.PrivatePreviews" data-setting="private-previews" /></label>
                    </div>
                </section>
                <section class="rd-card rd-compact" aria-labelledby="quiet-heading">
                                        <div><h2 id="quiet-heading">Quiet hours</h2><p class="field-help">@NotificationText.QuietHelp</p></div>
                    <div class="rd-age">
                        <div class="field rd-fill"><label for="quiet-from">From</label><input id="quiet-from" type="time" @bind="form.QuietFrom" data-setting="quiet-from" /></div>
                        <span class="field-help">to</span>
                        <div class="field rd-fill"><label for="quiet-until">Until</label><input id="quiet-until" type="time" @bind="form.QuietUntil" data-setting="quiet-until" /></div>
                    </div>
                    <div class="field"><label for="time-zone">Time zone</label><input id="time-zone" maxlength="64" @bind="form.TimeZone" data-setting="time-zone" /></div>
                </section>
                <section class="rd-card rd-compact" aria-labelledby="muted-heading">
                                        <div><h2 id="muted-heading">Muted modes</h2><p class="field-help">@NotificationText.MutedHelp</p></div>
                    <div class="rd-chips">
                        @foreach (var m in modes)
                        {
                            <label class="rd-chip"><input type="checkbox" checked="@form.Muted.Contains(m.Id)" @onchange="e => Mute(m.Id, e)" data-mute="@m.Id" />@m.Label</label>
                        }
                    </div>
                </section>
            </div>
            @* Issue 415 (D390): photos in chat and the unanswered-message limit live on Privacy & safety now. This save
               omits them, so the API keeps whatever is stored (PR 434 review). *@
            <div class="rd-actions">
                <p role="status" aria-live="polite" class="field-help rd-status" data-settings-status="@status">@message</p>
                <button type="submit" class="button" disabled="@busy" data-save-settings>Save settings</button>
            </div>
        </form>
    }
}
</div>
@code {
    private bool loaded, busy, barred;
    private NotificationCentre centre = new([], 0);
    private NotificationSettingsView? settings;
    private readonly Form form = new();
    private List<ConnectionModeView> modes = [];
    private string? status, message;

    private sealed class Form
    {
        public bool Messages { get; set; } = true;
        public bool Requests { get; set; } = true;
        public bool Connections { get; set; } = true;
        public bool Travel { get; set; } = true;
        public bool Push { get; set; } = true;
        public bool Email { get; set; } = true;
        public bool PrivatePreviews { get; set; } = true;
        public TimeOnly? QuietFrom { get; set; }
        public TimeOnly? QuietUntil { get; set; }
        public string TimeZone { get; set; } = "";
        public List<string> Muted { get; set; } = [];
    }

    protected override async Task OnInitializedAsync()
    {
        if (await Unread.LoadAsync()) centre = Unread.Centre ?? centre;
        var saved = await Members.NotificationSettingsAsync();
        // A restricted member reads their account notices here; the settings answer 403 for them.
        barred = saved.Code is ProblemCodes.AccountRestricted or ProblemCodes.AccountSuspended;
        if (saved.Value is { } s) Show(s);
        modes = (await Members.ModesAsync()).Value ?? [];
        loaded = true;
    }

    private void Show(NotificationSettingsView s)
    {
        settings = s;
        (form.Messages, form.Requests, form.Connections, form.Travel, form.Push, form.Email, form.PrivatePreviews) =
            (s.Messages, s.Requests, s.Connections, s.Travel, s.Push, s.Email, s.PrivatePreviews);
        (form.QuietFrom, form.QuietUntil, form.TimeZone, form.Muted) = (Parse(s.QuietFrom), Parse(s.QuietUntil), s.TimeZone, [.. s.MutedModes]);
    }

    private static string KindIcon(string kind) => kind switch
    {
        "message" or "conversationEnded" => "chat",
        "request" => "user",
        "connection" => "users",
        "travel" => "calendar",
        "policyChange" => "book",
        _ => "bell",
    };

    private static TimeOnly? Parse(string? time) => TimeOnly.TryParse(time, System.Globalization.CultureInfo.InvariantCulture, out var t) ? t : null;
    private static string? Text(TimeOnly? time) => time?.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private void Mute(string mode, ChangeEventArgs e)
    {
        if (e.Value is true) { if (!form.Muted.Contains(mode)) form.Muted.Add(mode); }
        else form.Muted.Remove(mode);
    }

    private async Task SaveAsync()
    {
        busy = true;
        var result = await Members.SaveNotificationSettingsAsync(new(form.Messages, form.Requests, form.Connections, form.Travel, form.Push, form.Email,
            form.PrivatePreviews, Text(form.QuietFrom), Text(form.QuietUntil), form.TimeZone, [.. form.Muted], ChatPhotos: null, UnansweredLimit: null));
        busy = false;
        if (result.Value is { } s) { Show(s); (status, message) = ("saved", "Saved."); }
        else (status, message) = (result.Code ?? "failed", result.Code == ProblemCodes.InvalidSettings
            ? "Check the quiet hours (set both or neither) and the time zone." : "Those settings couldn't be saved.");
    }

    private async Task ReadAsync(NotificationView n)
    {
        if (n.Read) return;
        // A refused read (an HTTP error is a status here, not an exception) changes nothing: the item is still unread.
        if (await Members.ReadNotificationAsync(n.Id) is < 200 or > 299) return;
        // Issue 472: the badges take the server's count, not this page's older snapshot (more may have arrived since). The
        // item itself shows as read even if that answer fails; the next refresh then corrects the count.
        centre = centre with { Items = [.. centre.Items.Select(i => i.Id == n.Id ? i with { Read = true } : i)], Unread = Math.Max(0, centre.Unread - 1) };
        if (await Unread.LoadAsync()) centre = Unread.Centre ?? centre;
    }

    private async Task ReadAllAsync()
    {
        await Members.ReadAllNotificationsAsync();
        if (await Unread.LoadAsync()) centre = Unread.Centre ?? centre;
    }
}
