@* Requests and connections (D112, Interactive WebAssembly): pending requests received (accept or decline) and sent
   (withdraw), accepted connections, and the people the member blocked (unblock). The API decides every list; blocked
   pairs and closed accounts never appear. Nothing connects until the recipient accepts.
   Issue 539 (owner, 26 November 2026): four navigable sections (left on wide screens, a compact switcher on narrow ones)
   instead of four large cards, with compact rows: thumbnail, name, age, mode and badges, as the API allows for that mode.
   Blocked rows show only the name the member blocked. *@
@implements IDisposable
@inject MemberClient Members
@inject NavigationManager Navigation
@inject Swoovr.Web.Client.Notifications.UnreadNotifications Unread
<div class="page-heading" data-connections="@(loaded ? (refused is null ? "ready" : "refused") : "loading")">
    <h1>Connections</h1>
    @if (!loaded) { <p role="status">Loading…</p> }
    else if (refused is not null) { <p role="status" data-connections-refused="@refused">@(refused == ProblemCodes.BetaNotEnrolled ? "Connections open once your email is on the invitation list." : "We couldn't load your connections.")</p> }
</div>
@if (loaded && refused is null)
{
    <p role="status" aria-live="polite" class="field-help" data-connections-status="@status">@message</p>
    <div class="cx-layout" data-connections-section="@section">
        <nav class="cx-nav" aria-label="Connections sections">
            @foreach (var (id, title, count) in Sections)
            {
                <button type="button" class="cx-nav-item" aria-pressed="@(section == id ? "true" : "false")" aria-controls="cx-panel" @onclick="() => section = id" data-section="@id">
                    <span>@title</span>@if (count > 0) { <span class="cx-count" data-section-count="@count"><span aria-hidden="true">@count</span><span class="visually-hidden"> waiting</span></span> }
                </button>
            }
        </nav>
        <section class="cx-panel" id="cx-panel" aria-labelledby="@($"{section}-heading")" data-box="@section">
            @switch (section)
            {
                case "received":
                    <h2 id="received-heading">Requests for you</h2>
                    @if (received.Count == 0) { <p class="field-help">No requests waiting.</p> }
                    else
                    {
                        <ul class="cx-rows">
                            @foreach (var request in received)
                            {
                                <li class="cx-row" data-request="@request.Id" data-request-mode="@request.Mode">
                                    @Person(request)
                                    <span class="cx-actions">
                                        <button type="button" class="button cx-button" disabled="@busy" @onclick='() => AnswerAsync(request, "accept")'>Accept</button>
                                        <button type="button" class="button button-secondary cx-button" disabled="@busy" @onclick='() => AnswerAsync(request, "decline")'>Decline</button>
                                    </span>
                                </li>
                            }
                        </ul>
                        @More("received", moreReceived)
                    }
                    break;
                case "sent":
                    <h2 id="sent-heading">Requests you sent</h2>
                    @if (sent.Count == 0) { <p class="field-help">Nothing waiting for an answer.</p> }
                    else
                    {
                        <ul class="cx-rows">
                            @foreach (var request in sent)
                            {
                                <li class="cx-row" data-request="@request.Id" data-request-mode="@request.Mode">
                                    @Person(request)
                                    <span class="cx-actions"><button type="button" class="button button-secondary cx-button" disabled="@busy" @onclick='() => AnswerAsync(request, "withdraw")'>Withdraw</button></span>
                                </li>
                            }
                        </ul>
                        @More("sent", moreSent)
                    }
                    break;
                case "connected":
                    <h2 id="connected-heading">Connected</h2>
                    @if (connected.Count == 0) { <p class="field-help">No connections yet. A connection starts when someone accepts a request.</p> }
                    else
                    {
                        <ul class="cx-rows">
                            @foreach (var request in connected)
                            {
                                <li class="cx-row" data-request="@request.Id" data-request-mode="@request.Mode">
                                    @Person(request)
                                    @if (confirmDisconnect == request.Id)
                                    {
                                        <span class="cx-confirm field-help">@MemberText.DisconnectExplained</span>
                                        <span class="cx-actions">
                                            <button type="button" class="button cx-button" disabled="@busy" @onclick="() => DisconnectAsync(request)" data-disconnect-confirm>Disconnect</button>
                                            <button type="button" class="button button-secondary cx-button" @onclick="() => confirmDisconnect = null">Keep</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="cx-actions"><button type="button" class="button button-secondary cx-button" disabled="@busy" @onclick="() => confirmDisconnect = request.Id" data-disconnect>Disconnect</button></span>
                                    }
                                </li>
                            }
                        </ul>
                        @More("connected", moreConnected)
                    }
                    break;
                default:
                    <h2 id="blocked-heading">Blocked</h2>
                    @if (blocked.Count == 0) { <p class="field-help">You haven't blocked anyone.</p> }
                    else
                    {
                        <ul class="cx-rows">
                            @foreach (var person in blocked)
                            {
                                @* Issue 539: only the name; no photo, age, mode or badges of someone blocked. *@
                                <li class="cx-row" data-blocked="@person.Id">
                                    <span class="cx-person"><span class="cx-thumb" aria-hidden="true">@Initial(person.DisplayName)</span><span class="cx-name">@(person.DisplayName ?? "Someone")</span></span>
                                    <span class="cx-actions"><button type="button" class="button button-secondary cx-button" disabled="@busy" @onclick="() => UnblockAsync(person.Id)">Unblock</button></span>
                                </li>
                            }
                        </ul>
                    }
                    break;
            }
        </section>
    </div>
}
@code {
    private bool loaded, busy, moreReceived, moreSent, moreConnected;
    private int pageReceived = 1, pageSent = 1, pageConnected = 1;
    private string? refused, status, message;
    private string section = "received";
    private List<ConnectionModeView> modes = [];
    private List<ConnectionRequestView> received = [], sent = [], connected = [];
    private IReadOnlyList<BlockedPerson> blocked = [];

    private IEnumerable<(string Id, string Title, int Count)> Sections =>
    [
        // PR 561 review: the server's total (as on the Connections tab), not the rows loaded so far.
        ("received", "Requests for you", Unread.PendingRequests ?? received.Count),
        ("sent", "Requests you sent", 0),
        ("connected", "Connected", 0),
        ("blocked", "Blocked", 0),
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var catalogue = await Members.ModesAsync();
            if (catalogue.Value is null) refused = catalogue.Code ?? "unavailable";
            else
            {
                modes = catalogue.Value;
                await LoadAsync();
                // Links such as /connections#blocked-heading open that section; otherwise requests first when any wait.
                section = Asked(Navigation.Uri) ?? (received.Count > 0 ? "received" : "connected");
                Navigation.LocationChanged += OnLocationChanged;
            }
        }
        catch (HttpRequestException) { refused = "unavailable"; }
        loaded = true;
    }

    private async Task LoadAsync()
    {
        var (inbox, outbox, links, blocks) = (await Members.RequestsAsync("received"), await Members.RequestsAsync("sent"), await Members.ConnectionsAsync(), await Members.BlocksAsync());
        (received, sent, connected, blocked) = ([.. inbox.Value?.Items ?? []], [.. outbox.Value?.Items ?? []], [.. links.Value?.Items ?? []], (IReadOnlyList<BlockedPerson>?)blocks.Value ?? []);
        (moreReceived, moreSent, moreConnected) = (inbox.Value?.More == true, outbox.Value?.More == true, links.Value?.More == true);
        (pageReceived, pageSent, pageConnected) = (1, 1, 1);
        await Unread.ChangedByMemberAsync();
    }

    /// <summary>Issue 539: the next page of a section, added below the rows already shown.</summary>
    private async Task MoreAsync(string box)
    {
        busy = true;
        var next = box == "connected" ? await Members.ConnectionsAsync(pageConnected + 1) : await Members.RequestsAsync(box, (box == "received" ? pageReceived : pageSent) + 1);
        if (next.Value is { } found)
        {
            switch (box)
            {
                case "received": received.AddRange(found.Items); (moreReceived, pageReceived) = (found.More, pageReceived + 1); break;
                case "sent": sent.AddRange(found.Items); (moreSent, pageSent) = (found.More, pageSent + 1); break;
                default: connected.AddRange(found.Items); (moreConnected, pageConnected) = (found.More, pageConnected + 1); break;
            }
        }
        busy = false;
    }

    private RenderFragment More(string box, bool more) => @<text>@if (more) { <button type="button" class="button button-secondary cx-more" disabled="@busy" @onclick="() => MoreAsync(box)" data-more="@box">Show more</button> }</text>;

    private async Task AnswerAsync(ConnectionRequestView request, string answer)
    {
        busy = true;
        var result = await Members.AnswerRequestAsync(request.Id, answer);
        (status, message) = result.Ok
            ? (answer, answer switch { "accept" => "Connected.", "decline" => "Declined. They won't be told why.", _ => "Request withdrawn." })
            : ("failed", "That request isn't available any more.");
        await LoadAsync(); // issue 540: also refreshes the shared count at once, even during a poll
        busy = false;
    }

    private Guid? confirmDisconnect;

    // D176: ends this mode's connection without blocking.
    private async Task DisconnectAsync(ConnectionRequestView request)
    {
        busy = true;
        var result = await Members.DisconnectAsync(request.Id);
        (status, message) = result.Ok ? ("disconnected", "Disconnected. They won't be told.") : ("failed", "That connection isn't available any more.");
        confirmDisconnect = null;
        await LoadAsync();
        busy = false;
    }

    private async Task UnblockAsync(Guid id)
    {
        busy = true;
        (status, message) = await Members.UnblockAsync(id) == 204 ? ("unblocked", "Unblocked. You may see each other again.") : ("failed", "That didn't work. Try again.");
        await LoadAsync();
        busy = false;
    }

    private static string? Asked(string uri)
    {
        var asked = new Uri(uri).Fragment.TrimStart('#').Replace("-heading", "");
        return asked is "received" or "sent" or "connected" or "blocked" ? asked : null;
    }

    // A link to another section on this page (only the fragment changes) switches to it too.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (Asked(e.Location) is { } asked && asked != section) { section = asked; InvokeAsync(StateHasChanged); }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private string Label(string id) => modes.FirstOrDefault(m => m.Id == id)?.Label ?? id;

    private static string Initial(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    /// <summary>Issue 539: thumbnail, name and age, the mode, and badges; the name opens their profile in that mode.</summary>
    private RenderFragment Person(ConnectionRequestView request) =>
        @<span class="cx-person">
            @if (request.Person.Photo is { } photo) { <img class="cx-thumb" src="@PhotoText.Web(photo.Link)" alt="" loading="lazy" data-row-photo /> }
            else { <span class="cx-thumb" aria-hidden="true">@Initial(request.Person.DisplayName)</span> }
            <span class="cx-who">
                <a class="cx-name" href="@($"/people/{request.Person.Id}?mode={request.Mode}")">@(request.Person.DisplayName ?? "Someone")@if (request.Person.Age is { } age) { <span class="cx-age" data-row-age>, @age</span> }</a>
                <span class="cx-meta"><span class="chip cx-mode">@Label(request.Mode)</span><BadgeRow Badges="request.Person.Badges" /></span>
            </span>
        </span>;
}
