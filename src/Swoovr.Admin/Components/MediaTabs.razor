@inject AdminClient Admin
<header class="ui-page-head">
    <h1>@Title</h1>
    <p>@Description</p>
</header>
<nav class="ui-tabs" aria-label="Media review sections">
    <a href="/media" aria-current="@(Active=="queue"?"page":null)">Queue @if(workload is{}w){<span class="ui-tab-count">@w.ManualReview</span>}</a>
    <a href="/media/appeals" aria-current="@(Active=="appeals"?"page":null)">Appeals @if(workload is{Appeals:>0}a){<span class="ui-tab-count">@a.Appeals</span>}@if(workload is{AwaitingOtherAdmin:>0}o){<span class="ui-tab-count ui-tab-count-waiting" data-awaiting-other-admin="@o.AwaitingOtherAdmin" title="@MediaText.AwaitingOtherAdmin(o.AwaitingOtherAdmin)"><span aria-hidden="true">@o.AwaitingOtherAdmin</span><span class="sr-only">@MediaText.AwaitingOtherAdmin(o.AwaitingOtherAdmin)</span></span>}</a>
    <a href="/media/history" aria-current="@(Active=="history"?"page":null)">History</a>
    @* D452 (issue 530): Photo Verified requests, compared with the member's profile photos. *@
    <a href="/media/photo-identified" aria-current="@(Active=="photo-identified"?"page":null)" data-tab-photo-identified>Photo Identified</a>
</nav>
@code {
    [Parameter, EditorRequired] public string Active { get; set; } = "queue";
    [Parameter] public string Title { get; set; } = "Media review";
    [Parameter] public string Description { get; set; } = "Uploads flagged by screening or held for manual review.";
    private PhotoWorkload? workload;
    protected override async Task OnInitializedAsync() => workload = (await Admin.PhotoWorkloadAsync()).Value;
}
