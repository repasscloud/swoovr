@page "/"
@inject AdminClient Admin
@inject IConfiguration Configuration
<PageTitle>Swoovr admin</PageTitle>
<h1>Overview</h1>
<details class="ui-card"><summary>Your MFA security</summary>
<p><a href="/sign-in?securityAction=CONFIGURE_TOTP" data-enhance-nav="false">Replace your authenticator</a></p>
@if(!root && Configuration.GetValue("Mfa:RecoveryCodesEnabled",false)) { <p><a href="/sign-in?securityAction=CONFIGURE_RECOVERY_AUTHN_CODES" data-enhance-nav="false">Generate your recovery codes</a></p> }
<p>Confirm through your identity provider. Staff MFA remains required.</p>
</details>
@if (businessOnly)
{
    <p data-business-home>You’re signed in to your staff workspace.</p>
}
else
{
<p class="page-description">Your queues and reviews at a glance.</p>
@if (holds is not null)
{
    <ul class="tiles" data-holds-overview>
        <li><a href="/holds"><strong data-live-holds>@holds.Live</strong> legal holds</a></li>
        <li><a href="/holds"><strong data-overdue-holds>@holds.Overdue</strong> holds overdue for review</a></li>
    </ul>
}
@if (legalOnly) { <p data-legal-home>You're signed in as the security and legal officer. <a href="/law-enforcement">Law-enforcement cases</a>, <a href="/holds">legal holds</a> or the <a href="/disclosures">disclosure register</a>.</p> }
@if (le is { Open: > 0 } || le is { RetrospectivesDue: > 0 })
{
    <ul class="tiles" data-le-home>
        <li><a href="/law-enforcement"><strong>@le.Open</strong> open law-enforcement cases</a></li>
        <li><a href="/law-enforcement"><strong>@le.Overdue</strong> overdue responses or updates</a></li>
    </ul>
}
else if (refused is not null)
{
    <p class="notice notice-action" role="alert" data-refused="@status"><span>@refused</span><a href="/sign-in?reauth=true" class="ui-button-primary notice-button" data-enhance-nav="false">Sign in again</a></p>
}
else
{
    <ul class="tiles" data-dashboard>
        <li><a href="/cases"><strong data-open-cases>@open</strong> open cases</a></li>
        <li><a href="/cases"><strong data-urgent>@urgent</strong> urgent awaiting acknowledgement</a></li>
        <li><a href="/appeals"><strong data-pending-appeals>@appeals</strong> appeals waiting</a></li>
        @if (dobReviews is { } dob) { <li><a href="/dob-reviews"><strong data-dob-reviews-waiting="@dob">@dob</strong> date of birth @(dob == 1 ? "review" : "reviews") waiting</a></li> }
    </ul>

}
@* Issue 223 (D332): support requests that aren't closed, by status, in this person's queues; each opens the filtered queue. *@
@if (tickets is { States.Count: > 0 } support)
{
    <ul class="tiles" data-ticket-overview>
        @foreach (var s in support.States)
        {
            <li><a href="@($"/tickets?state={s.StateId}")" data-ticket-overview-state="@s.Name"><strong>@s.Count@(support.More && s.Count > 0 ? "+" : "")</strong> @SupportTicketText.State(s.Name).ToLowerInvariant() support requests</a></li>
        }
    </ul>
    @if (support.More) { <p class="help" data-ticket-overview-more>Counts the 100 most recently updated open requests. Open the queue to see them all.</p> }
}
@* Image processing status (IMAGE-MODERATION-UAT.md): Support and Admin see whether photos are being checked and why any wait. *@
@if (processing is { } ip)
{
    <section class="ui-card image-processing" data-image-processing="@ip.State" aria-labelledby="image-processing-title">
        <div class="ui-card-head">
            <h2 id="image-processing-title">Image processing</h2>
            <span class="status-badge" data-level="@(ip.State == "unavailable" ? "urgent" : null)" data-image-processing-state>@ImageProcessingText.State(ip.State)</span>
        </div>
        <p class="help">@ImageProcessingText.Summary(ip.State)</p>
        <dl class="image-processing-services">
            <div><dt>Screening service</dt><dd data-screening-service>@ImageProcessingText.Service(ip.ScreeningReady)</dd></div>
            <div><dt>Malware scanner</dt><dd data-malware-scanner>@ImageProcessingText.Service(ip.MalwareScannerReady)</dd></div>
            <div><dt>Oldest waiting photo</dt><dd data-oldest-pending>@(ip.OldestPendingAt is { } oldest ? Waited(ip.CheckedAt - oldest) : "None waiting")</dd></div>
        </dl>
        <ul class="tiles" data-image-processing-counts>
            <li><a href="/media"><strong data-processing-pending>@ip.Pending</strong> waiting to be checked</a></li>
            <li><a href="/media"><strong data-processing-over-hour>@ip.PendingOverHour</strong> waiting over an hour</a></li>
            <li><a href="/media"><strong data-processing-stalled>@ip.Stalled</strong> stalled <span class="tile-note">Still private and retried hourly</span></a></li>
            <li><a href="/media"><strong data-processing-passed>@ip.Passed</strong> approved automatically <span class="tile-note">Last 24 hours</span></a></li>
            <li><a href="/media"><strong data-processing-review>@ip.Review</strong> sent to review <span class="tile-note">Last 24 hours</span></a></li>
            @if (ip.Blocked is { } blocked)
            {
                <li><a href="/media"><strong data-processing-blocked>@blocked</strong> known-content matches <span class="tile-note">Last 24 hours, sealed</span></a></li>
            }
        </ul>
        @if (ip.Paused > 0)
        {
            <p class="help" data-processing-paused="@ip.Paused">@ip.Paused more @(ip.Paused == 1 ? "photo is" : "photos are") on hold because the member's account is locked, suspended or being deleted. That's expected and isn't counted above.</p>
        }
        @if (ip.Reasons.Count > 0)
        {
            <h3 class="image-processing-subhead">Why photos are waiting</h3>
            <ul class="image-processing-reasons" data-image-processing-reasons>
                @foreach (var reason in ip.Reasons)
                {
                    <li data-processing-reason="@reason.Code"><span>@ImageProcessingText.Reason(reason.Code)</span> <strong>@reason.Count</strong>@if (reason.Stalled > 0) { <span class="tile-note"> (@reason.Stalled stalled)</span> }</li>
                }
            </ul>
        }
        <p class="help" data-image-processing-checked>Checked @AccountLabels.When(ip.CheckedAt). Reload the page to check again.</p>
    </section>
}
@if(photoWorkload is{}photos)
{
    <ul class="tiles" data-photo-workload><li><a href="/media"><strong>@photos.ManualReview</strong> awaiting media review</a></li><li><a href="/media"><strong>@photos.PendingScreening</strong> waiting for screening</a></li><li><a href="/media/appeals"><strong>@photos.Appeals</strong> media appeals @if(photos.AwaitingOtherAdmin>0){<span class="tile-note" data-awaiting-other-admin="@photos.AwaitingOtherAdmin">@MediaText.AwaitingOtherAdmin(photos.AwaitingOtherAdmin)</span>}</a></li></ul>
}
}
@code {
    private bool businessOnly;
    private int open, urgent, appeals, status;
    private int? dobReviews;
    private string? refused;
    private HoldOverview? holds;
    private PhotoWorkload? photoWorkload;
    private ImageProcessingStatus? processing;
    private bool legalOnly;
    private bool root;
    private LeOverview? le;
    private TicketOverview? tickets;

    protected override async Task OnInitializedAsync()
    {
        var workspace = (await Admin.WorkspaceAsync()).Value;
        root = workspace?.Root == true;
        dobReviews = workspace?.DobReviewsWaiting;
        businessOnly = workspace is { Business: true, MemberOperations: false, Legal: false, Administration: false };
        if (businessOnly) return;
        // Issue 223: refused (no ticket role, or the helpdesk unavailable) simply doesn't show.
        // A slow helpdesk never blocks the rest of the overview.
        try { tickets = (await Admin.TicketOverviewAsync()).Value; }
        catch (TaskCanceledException) { tickets = null; }
        catch (HttpRequestException) { tickets = null; }
        // D195: the officer's case timers (refused for everyone else, so it simply doesn't show).
        photoWorkload=(await Admin.PhotoWorkloadAsync()).Value;
        // Refused for staff without Support (it simply doesn't show); a slow API never blocks the rest of the overview.
        try { processing = (await Admin.ImageProcessingStatusAsync()).Value; }
        catch (TaskCanceledException) { processing = null; }
        catch (HttpRequestException) { processing = null; }
        le = (await Admin.LeOverviewAsync()).Value;
        // D189: overdue hold reviews head the page for admins and the security and legal officer.
        var overview = await Admin.HoldOverviewAsync();
        holds = overview.Value is { Live: > 0 } ? overview.Value : null;
        var cases = await Admin.CasesAsync();
        // The security and legal officer has no moderation queue; holds are their page.
        if (!cases.Ok && cases.Status == 403 && overview.Ok) { legalOnly = true; return; }
        if (!cases.Ok) { (status, refused) = (cases.Status, AdminText.Refusal(cases.Status, cases.Code)); return; }
        (open, urgent) = (cases.Value!.Count, cases.Value.Count(c => c.AwaitingAcknowledgement));
        appeals = (await Admin.AppealsAsync()).Value?.Count ?? 0;
    }

    private static string Waited(TimeSpan waited) => waited.TotalMinutes < 1 ? "Under a minute"
        : waited.TotalHours < 1 ? $"{(int)waited.TotalMinutes} min"
        : waited.TotalDays < 1 ? $"{(int)waited.TotalHours} h {waited.Minutes} min"
        : $"{(int)waited.TotalDays} d {waited.Hours} h";
}
