@page "/staff"
@inject AdminClient Admin
<PageTitle>Staff accounts — Swoovr admin</PageTitle>
@* issue 347: a directory that scales to hundreds of staff: search and filters, a scannable table, paging; creating an
   account and managing one live on their own pages. *@
<header class="ui-page-head staff-page-head">
    <div>
        <h1>Staff accounts</h1>
        <p>People who sign in to Swoovr Admin and the helpdesk. Open an account to see its roles, MFA, sessions and history.</p>
    </div>
    @if (accounts is not null)
    {
        <div class="staff-head-actions">
            @if (workspace?.AccountId is { } me) { <a class="ui-button-ghost" href="/staff/@me" data-my-staff-account>Your account</a> }
            <a class="ui-button-primary" href="/staff/new" data-staff-new>New staff account</a>
        </div>
    }
</header>
@if (message is not null) { <p class="notice" role="status" data-staff-result>@message</p> }
@if (accounts is not null)
{
    <section class="ui-card" aria-labelledby="staff-filter-heading">
        <h2 id="staff-filter-heading" class="sr-only">Find staff</h2>
        <form method="get" action="/staff" class="beta-filters staff-filters" data-enhance="false" aria-label="Find staff">
            <label class="ui-field beta-search"><span>Search</span><input name="search" type="search" value="@Search" maxlength="100" placeholder="Name or email…" autocomplete="off" /></label>
            <label class="ui-field"><span>Role</span><select name="role"><option value="">All roles</option>@foreach (var role in Roles) { <option value="@role" selected="@(role == Role)">@AccountLabels.Role(role)</option> }</select></label>
            <label class="ui-field"><span>Status</span><select name="status"><option value="">All statuses</option>@foreach (var value in Statuses) { <option value="@value" selected="@(value == Status)">@AccountLabels.Status(value)</option> }</select></label>
            <label class="ui-field"><span>MFA</span><select name="mfa"><option value="">Any</option>@foreach (var value in MfaStates) { <option value="@value" selected="@(Mfa == value)">@MfaText.Status(value)</option> }</select></label>
            <label class="ui-field"><span>Signed in since (UTC)</span><input name="since" type="date" value="@Since" /></label>
            <div class="beta-filter-actions staff-filter-actions"><a class="ui-button-ghost" href="/staff">Clear</a><button type="submit">Apply filters</button></div>
        </form>
        @if (ActiveFilters().Any())
        {
            <div class="beta-chips" aria-label="Active filters">Active filters:
                @foreach (var (key, text) in ActiveFilters()) { <a class="beta-chip" href="@Link(page: 1, without: key)" aria-label="Remove filter @text">@text <span aria-hidden="true">×</span></a> }
            </div>
        }
    </section>
    <div class="ui-results-head">
        <p data-staff-total="@accounts.Total"><strong>@accounts.Total</strong> staff account@(accounts.Total == 1 ? "" : "s")@if (Pages > 1) {<span> · page @accounts.Page of @Pages</span>}</p>
        @if (!string.IsNullOrEmpty(Mfa)) { <p>MFA is read live from the sign-in service</p> }
    </div>
    @if (accounts.Items.Count == 0)
    {
        <div class="ui-empty" data-staff-empty><strong>No staff match these filters</strong>Clear a filter or search by part of a name or email.</div>
    }
    else
    {
        <div class="table-scroll ui-table" tabindex="0" role="region" aria-label="Staff accounts; scroll horizontally on narrow screens">
        <table class="staff-table" data-staff-list="@accounts.Items.Count">
            <thead><tr><th scope="col">Staff member</th><th scope="col">Roles</th><th scope="col">Status</th>@if (!string.IsNullOrEmpty(Mfa)) {<th scope="col">MFA</th>}<th scope="col">Last sign-in</th><th scope="col"><span class="sr-only">Open</span></th></tr></thead>
            <tbody>
            @foreach (var row in accounts.Items)
            {
                var self = row.Id == workspace?.AccountId;
                <tr data-row-link data-staff-row="@row.Id" data-staff-status="@row.Status" class="@(self ? "is-self" : null)">
                    <td>
                        <div class="staff-identity">
                            <span class="staff-avatar staff-avatar-sm" aria-hidden="true">@AccountLabels.StaffInitials(row.FirstName, row.LastName, row.Email)</span>
                            <div>
                                <a href="/staff/@row.Id" data-row-target data-staff-link="@row.Id"><strong>@AccountLabels.StaffName(row.FirstName, row.LastName, row.Email)</strong></a>
                                @if (self) { <span class="staff-tag" data-staff-self>You</span> }
                                @if (row.Root) { <span class="staff-tag" data-staff-root>Root</span> }
                                @if (HasName(row) && !string.IsNullOrWhiteSpace(row.Email)) { <span class="ui-sub">@row.Email</span> }
                            </div>
                        </div>
                    </td>
                    <td>
                        @if (RoleList(row) is { Count: > 0 } roles)
                        {
                            <div class="staff-roles">@foreach (var role in roles) { <span class="staff-role" data-role="@role" title="@(row.EntraRoles?.Contains(role) == true ? "Managed in Microsoft Entra" : null)">@AccountLabels.Role(role)@if (row.EntraRoles?.Contains(role) == true) {<span class="staff-role-source"> · Entra</span>}</span> }</div>
                        }
                        else { <span class="ui-sub">No roles</span> }
                    </td>
                    <td><span class="ui-pill" data-tone="@StatusTone(row.Status)">@AccountLabels.Status(row.Status)</span></td>
                    @if (!string.IsNullOrEmpty(Mfa)) { <td>@MfaText.Status(row.Mfa)</td> }
                    <td>@AccountLabels.When(row.LastSignInAt, "Never")</td>
                    <td class="ui-right"><a class="ui-button-ghost" href="/staff/@row.Id">Open</a></td>
                </tr>
            }
            </tbody>
        </table></div>
        @if (Pages > 1)
        {
            <nav class="ui-paging" aria-label="Staff pages">
                <p class="ui-help">Showing @((accounts.Page - 1) * accounts.Size + 1)–@Math.Min(accounts.Page * accounts.Size, accounts.Total) of @accounts.Total</p>
                <div class="ui-paging-links">
                    <a class="ui-button-ghost" href="@Link(accounts.Page - 1)" aria-disabled="@(accounts.Page <= 1 ? "true" : null)">Previous</a>
                    <a class="ui-button-ghost" href="@Link(accounts.Page + 1)" aria-disabled="@(accounts.Page >= Pages ? "true" : null)">Next</a>
                </div>
            </nav>
        }
    }
}
@code {
    [SupplyParameterFromQuery(Name="search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name="role")] public string? Role { get; set; }
    [SupplyParameterFromQuery(Name="status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name="page")] public int Page { get; set; } = 1;
    [SupplyParameterFromQuery(Name="mfa")] public string? Mfa { get; set; }
    [SupplyParameterFromQuery(Name="since")] public string? Since { get; set; }
    internal static readonly string[] Roles = ["support", "trustSafety", "admin", "legal", "business"];
    private static readonly string[] Statuses = ["active", "locked", "suspended"];
    private static readonly string[] MfaStates = ["enabled", "setup-pending", "disabled"];
    private StaffAccountPage? accounts; private StaffWorkspace? workspace; private string? message;
    private int Pages => accounts is null || accounts.Size <= 0 ? 1 : Math.Max(1, (accounts.Total + accounts.Size - 1) / accounts.Size);

    protected override async Task OnInitializedAsync()
    {
        workspace = (await Admin.WorkspaceAsync()).Value;
        var result = await Admin.StaffAccountsAsync(Search, Role, Status, Math.Max(1, Page), mfa: Mfa,
            signedInAfter: DateTimeOffset.TryParse(Since, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.AssumeUniversal, out var since) ? since : null);
        accounts = result.Value;
        if (!result.Ok) message = AdminText.StaffListRefusal(result.Status, result.Code);
    }
    private static bool HasName(StaffAccountSummary row) => !string.IsNullOrWhiteSpace(row.FirstName) || !string.IsNullOrWhiteSpace(row.LastName);
    // The root account is an admin by definition (D364) even without a stored grant.
    private static List<string> RoleList(StaffAccountSummary row) => (row.Root && !row.Roles.Contains("admin") ? row.Roles.Append("admin") : row.Roles).OrderBy(r => Array.IndexOf(Roles, r)).ToList();
    internal static string StatusTone(string status) => status switch { "active" => "approve", "suspended" => "reject", _ => "pending" };
    private IEnumerable<(string Key, string Text)> ActiveFilters()
    {
        if (!string.IsNullOrWhiteSpace(Search)) yield return ("search", $"“{Search.Trim()}”");
        if (!string.IsNullOrEmpty(Role)) yield return ("role", AccountLabels.Role(Role));
        if (!string.IsNullOrEmpty(Status)) yield return ("status", AccountLabels.Status(Status));
        if (!string.IsNullOrEmpty(Mfa)) yield return ("mfa", "MFA " + MfaText.Status(Mfa).ToLowerInvariant());
        if (!string.IsNullOrEmpty(Since)) yield return ("since", "Signed in since " + Since);
    }
    private string Link(int page, string? without = null)
    {
        var query = new List<string>();
        void Add(string key, string? value) { if (key != without && !string.IsNullOrWhiteSpace(value)) query.Add($"{key}={Uri.EscapeDataString(value)}"); }
        Add("search", Search); Add("role", Role); Add("status", Status); Add("mfa", Mfa); Add("since", Since);
        if (page > 1) query.Add($"page={page}");
        return query.Count == 0 ? "/staff" : "/staff?" + string.Join('&', query);
    }
}
